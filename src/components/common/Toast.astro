<div 
  id="site-toast" 
  data-visible="false"
  class="fixed bottom-[max(1.5rem,env(safe-area-inset-bottom))] left-1/2 -translate-x-1/2 sm:left-auto sm:right-6 sm:translate-x-0 z-50 bg-olive-900/95 text-linen backdrop-blur-md px-5 py-3 rounded-full ring-1 ring-gold-accent/35 shadow-[0_16px_36px_-8px_rgba(29,44,30,0.35)] font-sans text-xs tracking-wide flex items-center gap-2.5 transition-[opacity,transform] duration-240 ease-[cubic-bezier(0.23,1,0.32,1)] data-[visible=false]:opacity-0 data-[visible=false]:translate-y-[120%] data-[visible=false]:scale-95 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0 data-[visible=true]:scale-100 data-[visible=true]:pointer-events-auto"
  role="status"
  aria-live="polite"
>
  <span class="w-1.5 h-1.5 rounded-full bg-gold-accent flex-shrink-0" aria-hidden="true"></span>
  <span id="site-toast-text"></span>
</div>

<script>
  let toastTimeout: ReturnType<typeof setTimeout> | null = null;
  const toast = document.getElementById('site-toast');
  const toastText = document.getElementById('site-toast-text');

  function scheduleHide(delay = 3200) {
    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => {
      if (toast) toast.dataset.visible = 'false';
    }, delay);
  }

  function displayToast(message: string) {
    if (!toast) return;
    if (toastText) toastText.textContent = message;
    toast.dataset.visible = 'true';
    scheduleHide(3200);
  }

  // Sonner Principle #4: pausar timer invisivelmente durante hover
  toast?.addEventListener('pointerenter', () => {
    if (toastTimeout) clearTimeout(toastTimeout);
  });
  toast?.addEventListener('pointerleave', () => {
    if (toast?.dataset.visible === 'true') scheduleHide(1800);
  });

  window.addEventListener('site-toast', ((e: CustomEvent<{ message: string }>) => {
    if (e.detail?.message) displayToast(e.detail.message);
  }) as EventListener);
</script>
