---
<div 
  id="site-toast" 
  class="fixed bottom-6 right-6 z-50 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-xl font-sans text-sm flex items-center gap-2 transform transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
  role="status"
  aria-live="polite"
>
  <span id="site-toast-text"></span>
</div>

<script>
  let toastTimeout: ReturnType<typeof setTimeout> | null = null;

  function displayToast(message: string) {
    const toast = document.getElementById('site-toast');
    const toastText = document.getElementById('site-toast-text');
    if (!toast) return;

    if (toastTimeout) {
      clearTimeout(toastTimeout);
    }

    if (toastText) toastText.textContent = message;
    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    toastTimeout = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }, 3500);
  }

  // Ouvinte de evento desacoplado
  window.addEventListener('site-toast', ((e: CustomEvent<{ message: string }>) => {
    if (e.detail?.message) {
      displayToast(e.detail.message);
    }
  }) as EventListener);

  // Compatibilidade com window.showToast
  (window as any).showToast = displayToast;
</script>
