---
import LeafIcon from './LeafIcon.astro';

interface Props {
  coupleNames?: string;
  weddingDateFormatted?: string;
}

const { coupleNames = "Tales & Camila", weddingDateFormatted = "19 de Dezembro de 2026" } = Astro.props;
---

<footer class="bg-linen-dark/80 py-16 border-t border-olive-900/[0.06] text-center mt-auto">
  <div class="max-w-4xl mx-auto px-4">
    <LeafIcon class="w-8 h-4 mx-auto mb-4 opacity-60" />
    <p class="font-serif text-3xl text-olive-900 tracking-[-0.015em] mb-1.5 font-normal">{coupleNames}</p>
    <p class="font-sans text-[11px] text-gold-text tracking-[0.26em] uppercase mb-6 font-medium">{weddingDateFormatted}</p>

    <nav aria-label="Links rápidos do rodapé" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-6 font-sans text-xs uppercase tracking-[0.16em] text-ink-muted">
      <a href="/#hero" class="min-h-[44px] inline-flex items-center hover:text-olive-900 transition-colors">Início</a>
      <a href="/#cerimonia" class="min-h-[44px] inline-flex items-center hover:text-olive-900 transition-colors">A Celebração</a>
      <a href="/#presentes" class="min-h-[44px] inline-flex items-center hover:text-olive-900 transition-colors">Presentes</a>
      <a href="/#rsvp" class="min-h-[44px] inline-flex items-center hover:text-olive-900 transition-colors">Confirmar Presença</a>
      <a href="/convite/" class="min-h-[44px] inline-flex items-center text-olive-800 font-medium hover:text-olive-900 transition-colors">Convite Digital</a>
    </nav>

    <p class="font-sans text-xs text-ink-subtle font-light">
      Feito com amor para celebrar este momento único ao lado das pessoas mais especiais.
    </p>
  </div>
</footer>
