---
interface Props {
  groomInit?: string;
  brideInit?: string;
}

const { groomInit = "T", brideInit = "C" } = Astro.props;
---

<header id="navbar" class="fixed top-0 inset-x-0 z-40 transition-[background-color,padding,box-shadow] duration-300 py-5 bg-transparent">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <!-- Logo / Iniciais -->
      <a href="#hero" class="font-serif text-2xl text-olive-800 tracking-wider hover:opacity-80 transition-opacity">
        {groomInit} <span class="font-serif italic text-gold-accent">&</span> {brideInit}
      </a>

      <!-- Menu Desktop -->
      <nav class="hidden md:flex items-center space-x-8" aria-label="Navegação principal">
        <a href="#hero" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase transition-colors">Home</a>
        <a href="#casal" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase transition-colors">O Casal</a>
        <a href="#cerimonia" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase transition-colors">Cerimônia & Recepção</a>
        <a href="#presentes" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase transition-colors">Lista de Presentes</a>
        <a href="#rsvp" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase transition-colors">Confirme sua Presença</a>
      </nav>

      <!-- Botão Mobile Hamburger com Acessibilidade ARIA -->
      <button 
        id="mobile-menu-toggle" 
        type="button"
        aria-label="Abrir menu de navegação" 
        aria-expanded="false" 
        aria-controls="mobile-menu"
        class="md:hidden text-gray-700 p-2 rounded-lg hover:bg-black/5 focus:outline-none cursor-pointer"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Menu Mobile Dropdown -->
    <div 
      id="mobile-menu" 
      class="hidden md:hidden mt-3 pt-3 pb-4 px-4 bg-white/95 backdrop-blur-md rounded-2xl shadow-xl border border-gray-100 flex flex-col space-y-3"
      role="region"
      aria-label="Menu móvel"
    >
      <a href="#hero" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase py-2">Home</a>
      <a href="#casal" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase py-2">O Casal</a>
      <a href="#cerimonia" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase py-2">Cerimônia & Recepção</a>
      <a href="#presentes" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase py-2">Lista de Presentes</a>
      <a href="#rsvp" class="nav-link font-sans text-xs tracking-widest text-gray-700 hover:text-olive-700 uppercase py-2">Confirme sua Presença</a>
    </div>
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function onWindowScroll() {
    if (!navbar) return;
    const scrolled = window.scrollY > 40;
    navbar.classList.toggle('bg-linen/90', scrolled);
    navbar.classList.toggle('backdrop-blur-md', scrolled);
    navbar.classList.toggle('shadow-sm', scrolled);
    navbar.classList.toggle('py-3', scrolled);
    navbar.classList.toggle('bg-transparent', !scrolled);
    navbar.classList.toggle('py-5', !scrolled);
  }

  window.addEventListener('scroll', onWindowScroll, { passive: true });
  onWindowScroll();

  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      const isHidden = mobileMenu.classList.toggle('hidden');
      mobileToggle.setAttribute('aria-expanded', String(!isHidden));
    });

    mobileMenu.querySelectorAll('.nav-link').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        mobileToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Scroll Spy nativo com IntersectionObserver para destacar a seção ativa
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = document.querySelectorAll<HTMLElement>('section[id]');

  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const activeHref = `#${entry.target.id}`;
            navLinks.forEach((link) => {
              const isActive = link.getAttribute('href') === activeHref;
              link.classList.toggle('text-olive-700', isActive);
              link.classList.toggle('font-semibold', isActive);
              link.classList.toggle('text-gray-700', !isActive);
            });
          }
        });
      },
      { rootMargin: '-35% 0px -55% 0px' }
    );
    sections.forEach((sec) => observer.observe(sec));
  }
</script>
