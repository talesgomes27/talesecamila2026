---
interface Props {
  targetDate: string;
}

const { targetDate } = Astro.props;
const initialDistance = Math.max(0, new Date(targetDate).getTime() - Date.now());
const initialDays = String(Math.floor(initialDistance / 86400000)).padStart(2, '0');
const initialHours = String(Math.floor((initialDistance % 86400000) / 3600000)).padStart(2, '0');
const initialMinutes = String(Math.floor((initialDistance % 3600000) / 60000)).padStart(2, '0');
const initialSeconds = String(Math.floor((initialDistance % 60000) / 1000)).padStart(2, '0');
---

<section 
  id="countdown-banner" 
  class="relative z-20 py-14 md:py-20 text-linen border-y border-gold-accent/40 shadow-[inset_0_1px_0_rgba(197,188,151,0.25),inset_0_-1px_0_rgba(197,188,151,0.25)]" 
  style="background: radial-gradient(ellipse 75% 85% at 50% 50%, #263828 0%, #152216 100%);"
  data-target-date={targetDate}
>
  <div class="max-w-4xl mx-auto px-4 text-center">
    <p class="font-sans text-[11px] uppercase tracking-[0.3em] text-gold-light mb-2.5 font-medium">
      19 de Dezembro de 2026
    </p>
    <h2 class="font-serif italic text-2xl md:text-3xl tracking-wide mb-8 font-normal text-linen/95 drop-shadow-sm">
      Contagem Regressiva
    </h2>

    <!-- Grid dos Números do Cronômetro -->
    <div id="countdown-grid" class="grid grid-cols-4 gap-2 sm:gap-4 max-w-2xl mx-auto transition-opacity duration-500">
      
      <!-- Dias -->
      <div class="countdown-divider flex flex-col items-center">
        <span id="countdown-days" class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal tracking-tight tabular-nums text-linen drop-shadow-[0_2px_10px_rgba(0,0,0,0.3)]">{initialDays}</span>
        <span class="font-sans text-[11px] tracking-[0.24em] uppercase mt-2.5 text-gold-light/90 font-medium">Dias</span>
      </div>

      <!-- Horas -->
      <div class="countdown-divider flex flex-col items-center">
        <span id="countdown-hours" class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal tracking-tight tabular-nums text-linen drop-shadow-[0_2px_10px_rgba(0,0,0,0.3)]">{initialHours}</span>
        <span class="font-sans text-[11px] tracking-[0.24em] uppercase mt-2.5 text-gold-light/90 font-medium">Horas</span>
      </div>

      <!-- Minutos -->
      <div class="countdown-divider flex flex-col items-center">
        <span id="countdown-minutes" class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal tracking-tight tabular-nums text-linen drop-shadow-[0_2px_10px_rgba(0,0,0,0.3)]">{initialMinutes}</span>
        <span class="font-sans text-[11px] tracking-[0.24em] uppercase mt-2.5 text-gold-light/90 font-medium">Minutos</span>
      </div>

      <!-- Segundos -->
      <div class="flex flex-col items-center">
        <span id="countdown-seconds" class="font-serif text-4xl sm:text-5xl md:text-6xl font-normal tracking-tight tabular-nums text-linen drop-shadow-[0_2px_10px_rgba(0,0,0,0.3)]">{initialSeconds}</span>
        <span class="font-sans text-[11px] tracking-[0.24em] uppercase mt-2.5 text-gold-light/90 font-medium">Segundos</span>
      </div>

    </div>
  </div>
</section>

<script>
  const banner = document.getElementById('countdown-banner');
  const grid = document.getElementById('countdown-grid');
  const dateStr = banner?.dataset.targetDate;

  if (banner && dateStr) {
    const targetTime = new Date(dateStr).getTime();
    const daysEl = document.getElementById('countdown-days');
    const hoursEl = document.getElementById('countdown-hours');
    const minutesEl = document.getElementById('countdown-minutes');
    const secondsEl = document.getElementById('countdown-seconds');

    const update = () => {
      const distance = targetTime - Date.now();
      if (distance <= 0) {
        clearInterval(timer);
        banner.innerHTML = `
          <div class="py-8 text-center text-white">
            <h2 class="font-serif text-3xl md:text-4xl mb-2">O grande dia chegou! ❤️</h2>
            <p class="font-sans text-sm tracking-widest uppercase">Celebrando o nosso amor hoje</p>
          </div>
        `;
        return;
      }

      if (daysEl) daysEl.textContent = String(Math.floor(distance / 86400000)).padStart(2, '0');
      if (hoursEl) hoursEl.textContent = String(Math.floor((distance % 86400000) / 3600000)).padStart(2, '0');
      if (minutesEl) minutesEl.textContent = String(Math.floor((distance % 3600000) / 60000)).padStart(2, '0');
      if (secondsEl) secondsEl.textContent = String(Math.floor((distance % 60000) / 1000)).padStart(2, '0');
      grid?.classList.remove('opacity-0');
    };

    const timer = setInterval(update, 1000);
    update();
  }
</script>
