---
import type { CoupleStory as CoupleStoryType } from '../../types/wedding';
import Carousel from './Carousel.astro';
import { Image } from 'astro:assets';
import groomImg from '../../assets/images/noivo.jpg';
import brideImg from '../../assets/images/noiva.jpg';

interface Props {
  story: CoupleStoryType;
}

const { story } = Astro.props;
---

<section id="casal" class="py-24 md:py-32 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
  <!-- Título da Seção -->
  <h2 class="font-serif text-4xl md:text-5xl text-olive-900 tracking-[-0.02em] mb-12 font-normal">
    {story.title}
  </h2>

  <!-- Fotos dos Noivos lado a lado com Double-Bezel Orgânico -->
  <div class="flex justify-center items-center gap-8 sm:gap-14 mb-12">
    <div class="flex flex-col items-center group">
      <div class="organic-profile-frame w-36 h-36 sm:w-48 sm:h-48 overflow-hidden p-1.5 bg-white/80 ring-1 ring-olive-900/10">
        <Image 
          id="groom-photo" 
          src={groomImg} 
          alt={story.groomName} 
          width={384}
          height={384}
          widths={[288, 384]}
          sizes="(max-width: 640px) 144px, 192px"
          quality={82}
          format="webp"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover rounded-[inherit] motion-safe:group-hover:scale-[1.03] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]" 
          style="object-position: center center;" 
        />
      </div>
      <span id="groom-name" class="font-serif italic text-xl text-olive-900 mt-4">{story.groomName}</span>
    </div>

    <div class="hidden sm:flex flex-col items-center text-gold-accent/70 select-none" aria-hidden="true">
      <span class="font-serif italic text-3xl">&</span>
    </div>

    <div class="flex flex-col items-center group">
      <div class="organic-profile-frame w-36 h-36 sm:w-48 sm:h-48 overflow-hidden p-1.5 bg-white/80 ring-1 ring-olive-900/10">
        <Image 
          id="bride-photo" 
          src={brideImg} 
          alt={story.brideName} 
          width={384}
          height={384}
          widths={[288, 384]}
          sizes="(max-width: 640px) 144px, 192px"
          quality={82}
          format="webp"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover rounded-[inherit] motion-safe:group-hover:scale-[1.03] transition-transform duration-700 ease-[cubic-bezier(0.32,0.72,0,1)]" 
          style="object-position: center center;" 
        />
      </div>
      <span id="bride-name" class="font-serif italic text-xl text-olive-900 mt-4">{story.brideName}</span>
    </div>
  </div>

  <!-- Texto de Boas-Vindas e História com Ritmo Editorial -->
  <div class="max-w-2xl mx-auto mb-16 px-2">
    <p id="couple-story-text" class="font-sans text-sm sm:text-base text-ink-muted leading-[1.9] font-light text-center">
      {story.text}
    </p>
    <div class="w-16 h-px bg-gold-accent/40 mx-auto mt-8"></div>
  </div>

  <!-- Carrossel de Fotos Pré-Wedding -->
  <Carousel gallery={story.gallery} />
</section>
