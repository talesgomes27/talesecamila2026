---
import type { CoupleStory as CoupleStoryType } from '../../types/wedding';
import LeafIcon from '../common/LeafIcon.astro';
import Carousel from './Carousel.astro';

interface Props {
  story: CoupleStoryType;
}

const { story } = Astro.props;
---

<section id="casal" class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
  <!-- Ícone de Folha Minimalista -->
  <LeafIcon />

  <!-- Título da Seção -->
  <h2 class="font-serif text-3xl md:text-4xl text-olive-600 mb-10 font-normal">
    {story.title}
  </h2>

  <!-- Fotos dos Noivos lado a lado -->
  <div class="flex justify-center items-center gap-6 sm:gap-10 mb-8">
    <div class="flex flex-col items-center">
      <div class="organic-profile-frame w-32 h-32 sm:w-44 sm:h-44 overflow-hidden border-2 border-white shadow-md bg-linen-light">
        <img 
          id="groom-photo" 
          src={story.groomPhoto} 
          alt={story.groomName} 
          class="w-full h-full object-cover" 
          style="object-position: center center;" 
        />
      </div>
      <span id="groom-name" class="font-serif text-lg text-gray-800 mt-3">{story.groomName}</span>
    </div>

    <div class="flex flex-col items-center">
      <div class="organic-profile-frame w-32 h-32 sm:w-44 sm:h-44 overflow-hidden border-2 border-white shadow-md bg-linen-light">
        <img 
          id="bride-photo" 
          src={story.bridePhoto} 
          alt={story.brideName} 
          class="w-full h-full object-cover" 
          style="object-position: center center;" 
        />
      </div>
      <span id="bride-name" class="font-serif text-lg text-gray-800 mt-3">{story.brideName}</span>
    </div>
  </div>

  <!-- Texto de Boas-Vindas e História -->
  <p id="couple-story-text" class="max-w-3xl mx-auto font-sans text-sm sm:text-base text-gray-600 leading-relaxed font-light mb-14 text-center px-4">
    {story.text}
  </p>

  <!-- Carrossel de Fotos Pré-Wedding -->
  <Carousel gallery={story.gallery} />
</section>
