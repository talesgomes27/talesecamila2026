---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { GiftItem, PixConfig } from '../../types/wedding';
import { formatCurrency } from '../../utils/currency';
import { generatePixPayload } from '../../utils/pix';
import QRCode from 'qrcode';

interface Props {
  gift: GiftItem;
  pix: PixConfig;
}

const { gift, pix } = Astro.props;
const formattedPrice = formatCurrency(gift.price);

const giftImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/presentes/*.{jpeg,jpg,png}',
  { eager: true }
);

const filename = gift.image.split('/').pop() || '';
const matchKey = Object.keys(giftImages).find((k) => k.endsWith(filename));
const imageMeta = matchKey ? giftImages[matchKey].default : null;

const pixPayload = generatePixPayload({
  key: pix.key,
  recipientName: pix.recipientName,
  city: pix.city,
  amount: gift.price,
  txid: `GIFT${gift.id}`
});

const qrDataUrl = await QRCode.toDataURL(pixPayload, {
  width: 190,
  margin: 1,
  color: {
    dark: '#2D3748',
    light: '#FFFFFF'
  }
});
---

<article 
  class="gift-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-[transform,box-shadow] duration-300 motion-safe:hover:-translate-y-1 flex flex-col border border-linen-dark group"
  data-id={gift.id}
  data-price={gift.price}
  data-price-formatted={formattedPrice}
  data-title={gift.title}
  data-pix-code={pixPayload}
  data-pix-qr={qrDataUrl}
>
  <div class="relative overflow-hidden aspect-[4/3] bg-linen-light">
    {imageMeta ? (
      <Image 
        src={imageMeta} 
        alt={gift.title} 
        width={480}
        height={360}
        quality={82}
        format="webp"
        loading="lazy" 
        decoding="async"
        class="gift-card-img w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500" 
      />
    ) : (
      <img 
        src={gift.image} 
        alt={gift.title} 
        width="480"
        height="360"
        loading="lazy" 
        decoding="async"
        class="gift-card-img w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform duration-500" 
      />
    )}
    <div class="absolute inset-0 bg-black/5 pointer-events-none"></div>
  </div>
  <div class="p-5 md:p-6 flex-1 flex flex-col justify-between text-center">
    <div>
      <h3 class="font-sans font-medium text-gray-800 text-base md:text-lg mb-2 line-clamp-2">{gift.title}</h3>
      {gift.description && <p class="font-sans text-xs text-gray-500 mb-4 line-clamp-2">{gift.description}</p>}
    </div>
    <div class="pt-2">
      <p class="font-serif text-2xl font-bold text-gray-900 mb-4">{formattedPrice}</p>
      <button 
        type="button" 
        class="presentear-btn w-full py-2.5 px-6 rounded-full bg-olive-600 hover:bg-olive-700 motion-safe:active:scale-95 text-white font-sans text-sm font-medium tracking-wide transition-colors duration-200 shadow-sm hover:shadow cursor-pointer"
        data-gift-id={gift.id}
      >
        Presentear
      </button>
    </div>
  </div>
</article>
