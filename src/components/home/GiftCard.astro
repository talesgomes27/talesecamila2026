---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { GiftItem, PixConfig } from '../../types/wedding';
import { formatCurrency } from '../../utils/currency';
import { generatePixPayload } from '../../utils/pix';

interface Props {
  gift: GiftItem;
  pix: PixConfig;
}

const { gift, pix } = Astro.props;
const formattedPrice = formatCurrency(gift.price);

const giftImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/presentes/*.{jpeg,jpg,png}',
  { eager: true }
);

const filename = gift.image.split('/').pop() || '';
const matchKey = Object.keys(giftImages).find((k) => k.endsWith(filename));
const imageMeta = matchKey ? giftImages[matchKey].default : null;

const pixPayload = generatePixPayload({
  key: pix.key,
  recipientName: pix.recipientName,
  city: pix.city,
  amount: gift.price,
  txid: `GIFT${gift.id}`
});
---

<article 
  class="gift-card double-bezel hover-lift flex flex-col group"
  data-id={gift.id}
  data-price={gift.price}
  data-price-formatted={formattedPrice}
  data-title={gift.title}
  data-pix-code={pixPayload}
>
  <div class="double-bezel-core overflow-hidden flex-1 flex flex-col">
    <div class="relative overflow-hidden aspect-[4/3] bg-linen-light m-1.5 rounded-[calc(1.625rem-0.25rem)]">
      {imageMeta ? (
        <Image 
          src={imageMeta} 
          alt={gift.title} 
          width={480}
          height={360}
          widths={[360, 480]}
          sizes="(max-width: 640px) calc(100vw - 48px), (max-width: 1024px) 45vw, 360px"
          quality={78}
          format="webp"
          loading="lazy" 
          decoding="async"
          class="gift-card-img w-full h-full object-cover transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" 
        />
      ) : (
        <img 
          src={gift.image} 
          alt={gift.title} 
          width="480"
          height="360"
          loading="lazy" 
          decoding="async"
          class="gift-card-img w-full h-full object-cover transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" 
        />
      )}
      <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-[inherit] pointer-events-none"></div>
    </div>

    <div class="p-5 md:p-6 flex-1 flex flex-col justify-between text-center">
      <div>
        <h3 class="font-serif text-xl sm:text-[22px] text-olive-900 leading-snug mb-2 line-clamp-2 font-normal tracking-[-0.01em]">
          {gift.title}
        </h3>
        {gift.description && (
          <p class="font-sans text-xs text-ink-muted leading-relaxed mb-5 line-clamp-2 font-light">
            {gift.description}
          </p>
        )}
      </div>

      <div class="pt-3 border-t border-olive-900/[0.06]">
        <p class="font-serif text-2xl sm:text-3xl font-normal tracking-[-0.02em] text-olive-900 mb-4">
          {formattedPrice}
        </p>
        <button 
          type="button" 
          class="presentear-btn btn-pill w-full min-h-[48px] py-2 pl-6 pr-2 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.18em] font-medium flex items-center justify-between cursor-pointer"
          data-gift-id={gift.id}
        >
          <span class="mx-auto pl-4">Presentear</span>
          <span class="btn-trailing-icon w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-[transform,background-color] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H8M17 7V16" />
            </svg>
          </span>
        </button>
      </div>
    </div>
  </div>
</article>
