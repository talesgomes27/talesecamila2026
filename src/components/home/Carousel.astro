---
import type { GalleryPhoto } from '../../types/wedding';

interface Props {
  gallery: GalleryPhoto[];
}

const { gallery } = Astro.props;
---

<div id="carousel-container" class="relative max-w-3xl mx-auto overflow-hidden rounded-2xl group">
  <!-- Trilho dos Slides -->
  <div id="carousel-track" class="carousel-track flex w-full">
    {gallery.map((item, index) => (
      <div class="carousel-slide flex-shrink-0 w-full relative overflow-hidden rounded-2xl h-[380px] sm:h-[460px] md:h-[520px] shadow-md bg-stone-900 flex items-center justify-center">
        <!-- Fundo desfocado para preencher as bordas de fotos com proporções diferentes -->
        <img 
          src={item.url} 
          alt="" 
          aria-hidden="true" 
          loading={index === 0 ? "eager" : "lazy"} 
          decoding="async" 
          class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-40 select-none pointer-events-none" 
        />
        <!-- Imagem principal 100% visível e sem cortes indesejados -->
        <img 
          src={item.url} 
          alt={item.caption || "Foto do casal"} 
          loading={index === 0 ? "eager" : "lazy"} 
          decoding="async" 
          class="relative z-10 max-h-full max-w-full object-contain select-none" 
        />
        {item.caption && (
          <div class="absolute bottom-0 inset-x-0 z-20 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 text-white text-center">
            <p class="font-sans text-sm md:text-base tracking-wide italic">{item.caption}</p>
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Botão Anterior -->
  <button 
    id="carousel-prev" 
    aria-label="Foto anterior" 
    class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/70 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-all shadow-md focus:outline-none opacity-80 group-hover:opacity-100"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <!-- Botão Próximo -->
  <button 
    id="carousel-next" 
    aria-label="Próxima foto" 
    class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/70 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-all shadow-md focus:outline-none opacity-80 group-hover:opacity-100"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <!-- Indicadores (Dots) -->
  <div id="carousel-dots" class="flex flex-wrap justify-center items-center gap-1.5 sm:gap-2 mt-4 px-2">
    {gallery.map((_, i) => (
      <button 
        aria-label={`Ir para foto ${i + 1}`} 
        class={`carousel-dot w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full transition-all duration-300 ${i === 0 ? 'bg-olive-600 scale-125' : 'bg-gray-300 hover:bg-olive-400'}`} 
        data-index={i}
      ></button>
    ))}
  </div>
</div>

<script>
  function setupCarousel() {
    const track = document.getElementById('carousel-track');
    const dotsContainer = document.getElementById('carousel-dots');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const carouselContainer = document.getElementById('carousel-container');

    if (!track) return;
    const slides = track.querySelectorAll('.carousel-slide');
    const totalSlides = slides.length;
    if (totalSlides === 0) return;

    let currentIndex = 0;

    function updateCarousel(newIndex: number) {
      currentIndex = (newIndex + totalSlides) % totalSlides;
      track!.style.transform = `translateX(-${currentIndex * 100}%)`;

      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.carousel-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.classList.remove('bg-gray-300', 'hover:bg-olive-400');
            dot.classList.add('bg-olive-600', 'scale-125');
          } else {
            dot.classList.remove('bg-olive-600', 'scale-125');
            dot.classList.add('bg-gray-300', 'hover:bg-olive-400');
          }
        });
      }
    }

    if (prevBtn) prevBtn.onclick = () => updateCarousel(currentIndex - 1);
    if (nextBtn) nextBtn.onclick = () => updateCarousel(currentIndex + 1);

    if (dotsContainer) {
      dotsContainer.onclick = (e) => {
        const target = (e.target as HTMLElement).closest('.carousel-dot') as HTMLElement;
        if (target && target.dataset.index) {
          const idx = parseInt(target.dataset.index, 10);
          updateCarousel(idx);
        }
      };
    }

    // Touch Swipe móvel
    let startX = 0;
    let endX = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          updateCarousel(currentIndex + 1);
        } else {
          updateCarousel(currentIndex - 1);
        }
      }
    }, { passive: true });

    // Autoplay com pausa no hover
    let autoPlay = setInterval(() => updateCarousel(currentIndex + 1), 6000);
    if (carouselContainer) {
      carouselContainer.onmouseenter = () => clearInterval(autoPlay);
      carouselContainer.onmouseleave = () => {
        clearInterval(autoPlay);
        autoPlay = setInterval(() => updateCarousel(currentIndex + 1), 6000);
      };
    }
  }

  setupCarousel();
  document.addEventListener('astro:page-load', setupCarousel);
</script>
