---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../../types/wedding';

interface Props {
  gallery: GalleryPhoto[];
}

const { gallery } = Astro.props;

// Carregar dinamicamente imagens do carrossel para processamento automatizado via Sharp (WebP responsivo)
const carouselImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/carrossel/*.{jpeg,jpg,png}', { eager: true });

const photosWithImages = gallery.map(item => {
  const filename = item.url.split('/').pop() || '';
  const matchKey = Object.keys(carouselImages).find(k => k.endsWith(filename));
  return {
    ...item,
    imageMeta: matchKey ? carouselImages[matchKey].default : null
  };
});
---

<div id="carousel-container" class="relative max-w-3xl mx-auto overflow-hidden rounded-2xl group select-none">
  <!-- Trilho dos Slides -->
  <div id="carousel-track" class="carousel-track flex w-full" style="touch-action: pan-y;">
    {photosWithImages.map((item, index) => (
      <div class="carousel-slide flex-shrink-0 w-full relative overflow-hidden rounded-2xl h-[380px] sm:h-[460px] md:h-[520px] shadow-md bg-stone-900 flex items-center justify-center">
        <!-- Fundo desfocado ultraleve (miniatura otimizada de 60px) -->
        {item.imageMeta ? (
          <Image 
            src={item.imageMeta} 
            alt="" 
            aria-hidden="true" 
            width={60}
            height={40}
            quality={20}
            format="webp"
            class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-35 pointer-events-none" 
          />
        ) : (
          <img 
            src={item.url} 
            alt="" 
            aria-hidden="true" 
            loading="lazy" 
            decoding="async" 
            class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-35 pointer-events-none" 
          />
        )}

        <!-- Imagem principal otimizada em WebP com dimensões contidas -->
        {item.imageMeta ? (
          <Image 
            src={item.imageMeta} 
            alt={item.caption || "Foto do casal Tales e Camila"} 
            width={860}
            height={580}
            quality={80}
            format="webp"
            loading={index === 0 ? "eager" : "lazy"} 
            class="relative z-10 max-h-full max-w-full object-contain pointer-events-none" 
          />
        ) : (
          <img 
            src={item.url} 
            alt={item.caption || "Foto do casal Tales e Camila"} 
            loading={index === 0 ? "eager" : "lazy"} 
            decoding="async" 
            class="relative z-10 max-h-full max-w-full object-contain pointer-events-none" 
          />
        )}

        {item.caption && (
          <div class="absolute bottom-0 inset-x-0 z-20 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-4 text-white text-center">
            <p class="font-sans text-sm md:text-base tracking-wide italic">{item.caption}</p>
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Botão Anterior -->
  <button 
    id="carousel-prev" 
    aria-label="Foto anterior" 
    class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/70 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-all shadow-md focus:outline-none opacity-80 group-hover:opacity-100 cursor-pointer"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
    </svg>
  </button>

  <!-- Botão Próximo -->
  <button 
    id="carousel-next" 
    aria-label="Próxima foto" 
    class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/70 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-all shadow-md focus:outline-none opacity-80 group-hover:opacity-100 cursor-pointer"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
    </svg>
  </button>

  <!-- Indicadores (Dots) -->
  <div id="carousel-dots" class="flex flex-wrap justify-center items-center gap-1.5 sm:gap-2 mt-4 px-2">
    {photosWithImages.map((_, i) => (
      <button 
        aria-label={`Ir para foto ${i + 1}`} 
        class={`carousel-dot w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'bg-olive-600 scale-125' : 'bg-gray-300 hover:bg-olive-400'}`} 
        data-index={i}
      ></button>
    ))}
  </div>
</div>

<script>
  let autoPlayTimer: ReturnType<typeof setInterval> | null = null;

  function setupCarousel() {
    if (autoPlayTimer) {
      clearInterval(autoPlayTimer);
      autoPlayTimer = null;
    }

    const track = document.getElementById('carousel-track');
    const dotsContainer = document.getElementById('carousel-dots');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const carouselContainer = document.getElementById('carousel-container');

    if (!track) return;
    const slides = track.querySelectorAll('.carousel-slide');
    const totalSlides = slides.length;
    if (totalSlides === 0) return;

    let currentIndex = 0;

    function updateCarousel(newIndex: number) {
      currentIndex = (newIndex + totalSlides) % totalSlides;
      if (track) {
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      if (dotsContainer) {
        const dots = dotsContainer.querySelectorAll('.carousel-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentIndex) {
            dot.classList.remove('bg-gray-300', 'hover:bg-olive-400');
            dot.classList.add('bg-olive-600', 'scale-125');
          } else {
            dot.classList.remove('bg-olive-600', 'scale-125');
            dot.classList.add('bg-gray-300', 'hover:bg-olive-400');
          }
        });
      }
    }

    if (prevBtn) prevBtn.onclick = () => updateCarousel(currentIndex - 1);
    if (nextBtn) nextBtn.onclick = () => updateCarousel(currentIndex + 1);

    if (dotsContainer) {
      dotsContainer.onclick = (e) => {
        const target = (e.target as HTMLElement).closest('.carousel-dot') as HTMLElement;
        if (target && target.dataset.index) {
          const idx = parseInt(target.dataset.index, 10);
          updateCarousel(idx);
        }
      };
    }

    // Touch Swipe móvel com prevenção de scroll colateral
    let startX = 0;
    let endX = 0;

    track.addEventListener('touchstart', (e: TouchEvent) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          updateCarousel(currentIndex + 1);
        } else {
          updateCarousel(currentIndex - 1);
        }
      }
    }, { passive: true });

    // Autoplay seguro com controle de timer
    autoPlayTimer = setInterval(() => updateCarousel(currentIndex + 1), 6000);

    if (carouselContainer) {
      carouselContainer.onmouseenter = () => {
        if (autoPlayTimer) clearInterval(autoPlayTimer);
      };
      carouselContainer.onmouseleave = () => {
        if (autoPlayTimer) clearInterval(autoPlayTimer);
        autoPlayTimer = setInterval(() => updateCarousel(currentIndex + 1), 6000);
      };
    }
  }

  setupCarousel();
  document.addEventListener('astro:page-load', setupCarousel);
</script>
