---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../../types/wedding';

interface Props {
  gallery: GalleryPhoto[];
}

const { gallery } = Astro.props;

const carouselImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/carrossel/*.{jpeg,jpg,png}',
  { eager: true }
);

const photos = gallery
  .map((item) => {
    const filename = item.url.split('/').pop() || '';
    const matchKey = Object.keys(carouselImages).find((k) => k.endsWith(filename));
    return matchKey ? { ...item, imageMeta: carouselImages[matchKey].default } : null;
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);
---

<div id="carousel-container" class="double-bezel relative max-w-[460px] sm:max-w-[500px] mx-auto w-full select-none group">
  <div class="double-bezel-core relative w-full aspect-[3/4] overflow-hidden bg-stone-900">
    <!-- Trilho Nativo CSS Scroll Snap -->
    <div
      id="carousel-track"
      tabindex="0"
      role="region"
      aria-roledescription="carrossel"
      aria-label="Galeria de fotos do casal — use as setas do teclado para navegar"
      class="flex w-full h-full overflow-x-auto snap-x snap-mandatory motion-safe:scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden focus-visible:outline-offset-[-4px]"
    >
      {photos.map((item, index) => (
        <div class="w-full h-full flex-shrink-0 snap-center relative">
          <Image
            src={item.imageMeta}
            alt={item.caption || `Foto ${index + 1} do casal Tales e Camila`}
            width={750}
            height={1000}
            widths={[450, 750]}
            sizes="(max-width: 640px) calc(100vw - 48px), 480px"
            quality={78}
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover pointer-events-none"
          />
        </div>
      ))}
    </div>

    <button
      id="carousel-prev"
      type="button"
      aria-label="Foto anterior"
      class="btn-pill absolute left-3.5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-linen/85 hover:bg-white text-olive-900 ring-1 ring-black/5 flex items-center justify-center backdrop-blur-md opacity-90 group-hover:opacity-100 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      id="carousel-next"
      type="button"
      aria-label="Próxima foto"
      class="btn-pill absolute right-3.5 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-linen/85 hover:bg-white text-olive-900 ring-1 ring-black/5 flex items-center justify-center backdrop-blur-md opacity-90 group-hover:opacity-100 cursor-pointer"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Affordance Visual de Swipe: Contador Editorial (ex: 1 / 15) -->
    <div
      id="carousel-counter"
      aria-live="polite"
      class="absolute bottom-3.5 right-3.5 z-20 px-3 py-1 rounded-full bg-linen/85 backdrop-blur-md ring-1 ring-black/5 font-sans text-[11px] tracking-[0.18em] text-olive-900 tabular-nums pointer-events-none"
    >
      1 / {photos.length}
    </div>
  </div>
</div>

<script>
  const track = document.getElementById('carousel-track');
  const prev = document.getElementById('carousel-prev');
  const next = document.getElementById('carousel-next');
  const counter = document.getElementById('carousel-counter');

  if (track) {
    const total = track.children.length;

    const updateCounter = () => {
      if (!counter || !track.clientWidth) return;
      const current = Math.min(total, Math.max(1, Math.round(track.scrollLeft / track.clientWidth) + 1));
      counter.textContent = `${current} / ${total}`;
    };

    track.addEventListener('scroll', updateCounter, { passive: true });

    const step = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      const nextPos = track.scrollLeft + dir * track.clientWidth;
      track.scrollTo({ left: nextPos > max + 10 ? 0 : nextPos < -10 ? max : nextPos, behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let timer = setInterval(() => step(1), 6000);
      track.addEventListener('pointerenter', () => clearInterval(timer));
      track.addEventListener('pointerleave', () => (timer = setInterval(() => step(1), 6000)));
    }
  }
</script>
