---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '../../types/wedding';

interface Props {
  gallery: GalleryPhoto[];
}

const { gallery } = Astro.props;

const carouselImages = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/carrossel/*.{jpeg,jpg,png}',
  { eager: true }
);

const photos = gallery
  .map((item) => {
    const filename = item.url.split('/').pop() || '';
    const matchKey = Object.keys(carouselImages).find((k) => k.endsWith(filename));
    return matchKey ? { ...item, imageMeta: carouselImages[matchKey].default } : null;
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);
---

<div id="carousel-container" class="relative max-w-[460px] sm:max-w-[500px] mx-auto w-full select-none group">
  <div class="relative w-full aspect-[3/4] overflow-hidden rounded-2xl shadow-xl bg-stone-900">
    <!-- Trilho Nativo CSS Scroll Snap -->
    <div
      id="carousel-track"
      class="flex w-full h-full overflow-x-auto snap-x snap-mandatory motion-safe:scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {photos.map((item, index) => (
        <div class="w-full h-full flex-shrink-0 snap-center relative">
          <Image
            src={item.imageMeta}
            alt={item.caption || `Foto ${index + 1} do casal Tales e Camila`}
            width={750}
            height={1000}
            quality={82}
            format="webp"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover pointer-events-none"
          />
        </div>
      ))}
    </div>

    <button
      id="carousel-prev"
      type="button"
      aria-label="Foto anterior"
      class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/85 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-opacity shadow-md opacity-80 group-hover:opacity-100 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      id="carousel-next"
      type="button"
      aria-label="Próxima foto"
      class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 rounded-full bg-white/85 hover:bg-white text-gray-800 flex items-center justify-center backdrop-blur-sm transition-opacity shadow-md opacity-80 group-hover:opacity-100 cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  const track = document.getElementById('carousel-track');
  const prev = document.getElementById('carousel-prev');
  const next = document.getElementById('carousel-next');

  if (track) {
    const step = (dir: number) => {
      const max = track.scrollWidth - track.clientWidth;
      const nextPos = track.scrollLeft + dir * track.clientWidth;
      track.scrollTo({ left: nextPos > max + 10 ? 0 : nextPos < -10 ? max : nextPos, behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let timer = setInterval(() => step(1), 6000);
      track.addEventListener('pointerenter', () => clearInterval(timer));
      track.addEventListener('pointerleave', () => (timer = setInterval(() => step(1), 6000)));
    }
  }
</script>
