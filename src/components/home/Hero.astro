---
import type { CoupleInfo } from '../../types/wedding';
import LeafIcon from '../common/LeafIcon.astro';
import { Image } from 'astro:assets';
import coupleHeroImg from '../../assets/images/casal.jpg';

interface Props {
  couple: CoupleInfo;
}

const { couple } = Astro.props;
---

<section id="hero" class="relative min-h-[92dvh] flex items-center pt-28 pb-20 md:pt-36 md:pb-28 overflow-hidden">
  <!-- Ilustração Botânica no Canto Esquerdo -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-44 md:w-64 pointer-events-none opacity-65 select-none z-0" aria-hidden="true">
    <img src="/assets/svgs/botanical-branch.svg" alt="" width="256" height="384" decoding="async" class="w-full h-auto" />
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">
      
      <!-- Nomes e Data (Coluna Esquerda com Stagger de 60ms) -->
      <div class="md:col-span-6 text-center flex flex-col items-center justify-center order-2 md:order-1">
        <span class="eyebrow-tag mb-6 stagger-item" style="--stagger-index: 0;">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-accent"></span>
          {couple.heroSubtitle}
          <span class="w-1.5 h-1.5 rounded-full bg-gold-accent"></span>
        </span>
        
        <h1 class="font-serif text-6xl sm:text-7xl lg:text-[5.5rem] text-olive-900 tracking-[-0.025em] leading-[0.94] font-normal mb-2 stagger-item" style="--stagger-index: 1;">
          <span class="block">{couple.groom}</span>
          <span class="font-serif italic text-3xl sm:text-4xl md:text-5xl text-gold-accent font-normal my-2 block">&</span>
          <span class="block">{couple.bride}</span>
        </h1>

        <!-- Detalhe da Folha -->
        <div class="stagger-item" style="--stagger-index: 2;">
          <LeafIcon class="my-5 w-11 h-5 opacity-70" />
        </div>

        <!-- Data Formatada em Moldura Editorial -->
        <div class="inline-flex items-center space-x-3 text-ink-muted font-sans tracking-[0.28em] text-xs sm:text-sm border-y border-gold-accent/35 py-2 px-6 mb-8 stagger-item tabular-nums" style="--stagger-index: 3;">
          <span>{couple.displayDate}</span>
        </div>

        <!-- Atalhos de Ação Rápida na Dobra Principal (Hit Area >= 44px) -->
        <div id="hero-ctas" class="flex flex-wrap items-center justify-center gap-3 w-full sm:w-auto stagger-item" style="--stagger-index: 4;">
          <a
            href="#rsvp"
            class="btn-pill min-h-[44px] w-full sm:w-auto px-7 py-2.5 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.18em] font-medium inline-flex items-center justify-center gap-2"
          >
            <span>Confirmar Presença</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7" />
            </svg>
          </a>
          <a
            href="#presentes"
            class="btn-pill min-h-[44px] w-full sm:w-auto px-7 py-2.5 bg-white/85 hover:bg-white text-olive-900 ring-1 ring-olive-900/15 font-sans text-xs uppercase tracking-[0.18em] font-medium inline-flex items-center justify-center gap-2"
          >
            <span>Lista de Presentes</span>
          </a>
        </div>
      </div>

      <!-- Foto do Casal com Moldura Orgânica e Duplo Anel (Coluna Direita — LCP Frame 0 sem opacity:0) -->
      <div class="md:col-span-6 flex justify-center items-center relative order-1 md:order-2">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-[400px] md:h-[400px]">
          
          <!-- Folhagens ao redor da moldura -->
          <div class="absolute -inset-6 md:-inset-10 pointer-events-none z-10 opacity-85 select-none" aria-hidden="true">
            <img src="/assets/svgs/hero-frame-leaves.svg" alt="" width="440" height="440" decoding="async" class="w-full h-full object-contain" />
          </div>

          <!-- Moldura Orgânica Dupla (Outer Ring + Inner Core) -->
          <div class="organic-hero-frame w-full h-full overflow-hidden bg-white/75 p-2 sm:p-2.5 ring-1 ring-olive-900/10 relative z-0">
            <Image 
              id="hero-couple-img" 
              src={coupleHeroImg} 
              alt={`Foto do casal ${couple.names}`} 
              width={768}
              height={768}
              widths={[384, 512, 768]}
              sizes="(max-width: 640px) 256px, (max-width: 768px) 320px, 400px"
              quality={85}
              format="webp"
              loading="eager"
              decoding="sync"
              fetchpriority="high"
              class="w-full h-full object-cover rounded-[inherit] ring-1 ring-black/5"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
