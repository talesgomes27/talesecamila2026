---
import type { CoupleInfo } from '../../types/wedding';
import { weddingData } from '../../data/weddingData';
import { Image } from 'astro:assets';
import coupleHeroImg from '../../assets/images/casal.jpg';
interface Props { couple: CoupleInfo; }
const { couple } = Astro.props;
const { ceremony, rsvp } = weddingData;
---

<section id="hero" class="relative pt-28 pb-12 md:pt-36 md:pb-20 overflow-hidden">
  <div class="absolute -left-20 bottom-0 w-52 md:w-72 pointer-events-none opacity-20" aria-hidden="true">
    <img src="/assets/svgs/botanical-branch.svg" alt="" width="256" height="384" decoding="async" class="w-full h-auto" />
  </div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative grid grid-cols-1 md:grid-cols-12 gap-x-4 gap-y-5 md:gap-x-14 items-center justify-center">
    <h1 class="md:col-span-6 text-center font-serif text-[2.15rem] sm:text-5xl lg:text-6xl text-olive-900 leading-tight tracking-[-0.02em]">
      {couple.groom} <span class="font-serif italic text-gold-accent font-normal">&amp;</span> {couple.bride}
    </h1>
    <div class="hero-photo col-start-2 row-start-1 md:col-start-8 md:col-span-5 md:row-span-2 flex justify-center">
      <div class="relative w-48 max-w-full aspect-square md:w-full md:max-w-[400px]">
        <img src="/assets/svgs/hero-frame-leaves.svg" alt="" width="440" height="440" class="absolute -inset-2 md:-inset-8 w-[calc(100%+1rem)] md:w-[calc(100%+4rem)] max-w-none pointer-events-none" aria-hidden="true" />
        <div class="organic-hero-frame w-full h-full overflow-hidden bg-white p-1 md:p-2.5 relative">
          <Image id="hero-couple-img" src={coupleHeroImg} alt={`Foto do casal ${couple.names}`} width={768} height={768} widths={[192, 384, 768]} sizes="(max-width: 767px) 192px, 400px" quality={85} format="webp" loading="eager" fetchpriority="high" class="w-full h-full object-cover rounded-[inherit]" />
        </div>
      </div>
    </div>
    <div class="hero-info col-span-2 md:col-span-6 md:row-start-2 text-center text-olive-900">
      <p class="font-serif text-2xl sm:text-3xl mb-4"><time datetime="2026-12-19">{ceremony.dateFormatted}</time></p>
      <dl class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-lg mb-4">
        <div><dt class="text-base text-ink-muted">Chegada</dt><dd class="font-semibold tabular-nums">{ceremony.arrivalTime}</dd></div>
        <div><dt class="text-base text-ink-muted">Cerimônia</dt><dd class="font-semibold tabular-nums">{ceremony.ceremonyTime}</dd></div>
      </dl>
      <p class="text-lg font-medium leading-snug">{ceremony.venueName}</p>
      <p class="text-base text-ink-muted mt-1">São Miguel do Guamá, PA</p>
      <p class="text-base text-ink-muted mt-4">Confirme até <time datetime={rsvp.deadlineDate} class="font-medium text-olive-900">{rsvp.deadlineFormatted}</time>.</p>
      <div id="hero-ctas" class="grid grid-cols-2 justify-center gap-3 mt-6">
        <a href="#rsvp" class="btn-pill col-span-2 min-h-[48px] px-5 py-3 bg-olive-800 hover:bg-olive-900 text-linen text-base font-medium inline-flex items-center justify-center">Confirmar presença</a>
        <a href="#cerimonia" class="btn-pill min-h-[48px] px-2 py-3 bg-white/90 text-olive-900 ring-1 ring-olive-900/20 text-base font-medium inline-flex items-center justify-center text-center">Como chegar</a>
        <a href="#presentes" class="btn-pill min-h-[48px] px-2 py-3 bg-white/90 text-olive-900 ring-1 ring-olive-900/20 text-base font-medium inline-flex items-center justify-center text-center">Ver presentes</a>
      </div>
    </div>
  </div>
</section>
