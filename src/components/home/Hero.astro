---
import type { CoupleInfo } from '../../types/wedding';
import LeafIcon from '../common/LeafIcon.astro';

interface Props {
  couple: CoupleInfo;
}

const { couple } = Astro.props;
---

<section id="hero" class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
  <!-- Ilustração Botânica no Canto Esquerdo -->
  <div class="absolute left-0 top-1/2 -translate-y-1/2 w-44 md:w-64 pointer-events-none opacity-80 select-none z-0">
    <img src="/assets/svgs/botanical-branch.svg" alt="Ramo floral botânico" class="w-full h-auto" />
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
      
      <!-- Nomes e Data (Coluna Esquerda) -->
      <div class="md:col-span-6 text-center md:text-center flex flex-col items-center justify-center order-2 md:order-1">
        <p class="font-sans text-xs md:text-sm tracking-[0.3em] uppercase text-olive-600 mb-3 font-medium">
          {couple.heroSubtitle}
        </p>
        
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl text-gray-800 tracking-tight leading-none mb-1">
          <span class="block">{couple.groom}</span>
          <span class="font-cormorant italic text-3xl md:text-5xl text-gold-accent my-1 block">&</span>
          <span class="block">{couple.bride}</span>
        </h1>

        <!-- Detalhe da Folha -->
        <LeafIcon class="my-4 w-12 h-6 opacity-75" />

        <!-- Data Formatada -->
        <div class="inline-flex items-center space-x-3 text-gray-700 font-sans tracking-widest text-sm md:text-base border-t border-b border-olive-200 py-1.5 px-4">
          <span>{couple.displayDate}</span>
        </div>
      </div>

      <!-- Foto do Casal com Moldura Orgânica (Coluna Direita) -->
      <div class="md:col-span-6 flex justify-center items-center relative order-1 md:order-2">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-96 md:h-96">
          
          <!-- Folhagens ao redor da moldura (Image 1) -->
          <div class="absolute -inset-6 md:-inset-10 pointer-events-none z-10 opacity-85 select-none">
            <img src="/assets/svgs/hero-frame-leaves.svg" alt="Folhagens decorativas" class="w-full h-full object-contain" />
          </div>

          <!-- Moldura Orgânica da Foto -->
          <div class="organic-hero-frame w-full h-full overflow-hidden bg-linen-light p-2 border-2 border-white relative z-0">
            <img 
              id="hero-couple-img" 
              src={couple.heroPhoto} 
              alt={couple.names} 
              class="w-full h-full object-cover rounded-[inherit]"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
