---
import type { CeremonyInfo } from '../../types/wedding';
import { calendarLinks } from '../../data/weddingData';
import { Image } from 'astro:assets';
import venueImg from '../../assets/images/cerimonia.jpeg';

interface Props {
  ceremony: CeremonyInfo;
}

const { ceremony } = Astro.props;
---

<section id="cerimonia" class="py-24 md:py-32 bg-linen-light/70 border-y border-olive-900/[0.06] reveal-on-scroll">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Eyebrow Capítulo II -->
    <div class="mb-4">
      <span class="eyebrow-tag">Cap. II • A Celebração</span>
    </div>

    <h2 class="font-serif text-4xl md:text-5xl text-olive-900 tracking-[-0.02em] mb-12 font-normal">
      {ceremony.title}
    </h2>

    <!-- Card do Local em Arquitetura Double-Bezel -->
    <div class="double-bezel mb-10 text-left">
      <div class="double-bezel-core overflow-hidden">
        <!-- Foto do Local Emoldurada -->
        <div class="m-1.5 sm:m-2 rounded-[calc(1.625rem-0.25rem)] h-72 sm:h-96 md:h-[460px] overflow-hidden bg-linen-light relative flex items-center justify-center">
          <Image 
            id="ceremony-venue-photo" 
            src={venueImg} 
            alt={ceremony.venueName} 
            width={960}
            height={540}
            widths={[480, 960]}
            sizes="(max-width: 640px) calc(100vw - 48px), 860px"
            quality={80}
            format="webp"
            loading="lazy"
            decoding="async"
            class="relative z-10 w-full h-full object-cover object-center select-none" 
          />
          <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-[inherit] z-20 pointer-events-none"></div>
        </div>

        <!-- Informações Detalhadas -->
        <div class="p-6 sm:p-10 text-center max-w-2xl mx-auto">
          <h3 id="ceremony-venue-name" class="font-serif text-2xl sm:text-3xl md:text-4xl text-olive-900 tracking-[-0.015em] mb-2 font-normal">
            {ceremony.venueName}
          </h3>
          <p id="ceremony-date-text" class="font-sans text-xs sm:text-sm uppercase tracking-[0.22em] text-gold-text font-medium mb-6">
            {ceremony.dateFormatted} • {ceremony.time}
          </p>
          
          <p id="ceremony-notes" class="font-sans text-sm sm:text-base text-ink-muted leading-[1.85] font-light mb-6">
            {ceremony.notes}
          </p>

          <!-- Informações de Traje & Dica da Noiva (Double-Bezel Interno) -->
          <div class="my-8 p-5 sm:p-6 rounded-2xl bg-linen/70 ring-1 ring-olive-900/[0.08] text-center max-w-lg mx-auto space-y-3">
            <div>
              <span class="inline-block font-sans text-xs font-medium uppercase tracking-[0.2em] text-olive-900">
                Traje: Casual Chique
              </span>
              <p class="font-serif italic text-sm text-ink-muted mt-1">
                (Pedimos a gentileza de não usar trajes em tons de verde e/ou branco)
              </p>
            </div>
            <div class="w-10 h-px bg-gold-accent/40 mx-auto"></div>
            <p class="font-sans text-xs sm:text-sm text-ink-muted leading-relaxed font-light">
              <strong class="text-olive-800 font-medium uppercase tracking-wider text-[11px] block mb-1">Nota da Noiva</strong>
              Meninas, o terreno é arenoso: evitem vestido longo e salto fino; apostem no comprimento mídi e salto bloco!
            </p>
          </div>

          <p id="ceremony-address" class="font-sans text-xs sm:text-sm text-ink-subtle font-normal mb-8">
            {ceremony.address}
          </p>

          <!-- Botões de Ação para Rotas e Agenda (Hit Area >= 44px) -->
          <div class="flex flex-wrap justify-center gap-3">
            <a 
              id="ceremony-maps-btn" 
              href={ceremony.mapsUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-pill min-h-[44px] inline-flex items-center gap-2.5 py-2 pl-5 pr-2.5 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.16em] font-medium group"
            >
              <span>Google Maps</span>
              <span class="btn-trailing-icon w-7 h-7 rounded-full bg-white/10 flex items-center justify-center transition-[transform,background-color] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H8M17 7V16"/>
                </svg>
              </span>
            </a>

            <a 
              id="ceremony-waze-btn" 
              href={ceremony.wazeUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-pill min-h-[44px] inline-flex items-center gap-2 py-2.5 px-5 bg-white hover:bg-linen text-olive-900 ring-1 ring-olive-900/15 font-sans text-xs uppercase tracking-[0.16em] font-medium"
            >
              <svg class="w-3.5 h-3.5 text-gold-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Abrir no Waze
            </a>

            <a 
              href={calendarLinks.googleUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-pill min-h-[44px] inline-flex items-center gap-2 py-2.5 px-5 bg-linen hover:bg-linen-dark text-ink-muted ring-1 ring-olive-900/10 font-sans text-xs uppercase tracking-[0.16em] font-medium"
            >
              <svg class="w-3.5 h-3.5 text-olive-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Google Agenda
            </a>

            <a 
              href={calendarLinks.icsDataUri} 
              download="casamento-tales-e-camila.ics"
              class="btn-pill min-h-[44px] inline-flex items-center gap-2 py-2.5 px-5 bg-linen hover:bg-linen-dark text-ink-muted ring-1 ring-olive-900/10 font-sans text-xs uppercase tracking-[0.16em] font-medium"
            >
              <svg class="w-3.5 h-3.5 text-olive-700" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.63 1.35-.57.66-.97 1.73-.84 2.76 1 .08 2.03-.51 2.55-1.26z"/>
              </svg>
              Apple / iCal
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Mapa Interativo sob Demanda (Fachada Click-to-Load em Double-Bezel — Economiza ~500KB no 4G) -->
    <div class="double-bezel mb-14">
      <div
        id="ceremony-map-container"
        data-embed-url={ceremony.mapsEmbedUrl}
        class="double-bezel-core w-full h-72 md:h-96 overflow-hidden bg-linen-light relative flex flex-col items-center justify-center p-6 text-center"
      >
        <div id="ceremony-map-facade" class="max-w-md mx-auto flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-olive-900/[0.06] ring-1 ring-olive-900/10 flex items-center justify-center mb-3.5 text-olive-800" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <p class="font-serif text-xl sm:text-2xl text-olive-900 mb-1 font-normal">
            {ceremony.venueName}
          </p>
          <p class="font-sans text-xs text-ink-subtle mb-5">
            {ceremony.address} • Estacionamento na Orla do Rio Guamá
          </p>
          <button
            type="button"
            id="load-map-btn"
            class="btn-pill min-h-[44px] px-6 py-2.5 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.16em] font-medium inline-flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            <span>Carregar Mapa Interativo</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Guia do Convidado & Dúvidas Frequentes (Acordeão Editorial Nativo) -->
    {ceremony.faq && ceremony.faq.length > 0 && (
      <div id="ceremony-faq" class="max-w-3xl mx-auto text-left">
        <div class="text-center mb-8">
          <span class="eyebrow-tag mb-2">Dicas & Logística</span>
          <h3 class="font-serif text-2xl sm:text-3xl text-olive-900 tracking-[-0.015em] font-normal">
            Guia Rápido para Convidados
          </h3>
        </div>

        <div class="space-y-4">
          {ceremony.faq.map((item, idx) => (
            <div class="double-bezel">
              <details class="faq-item double-bezel-core group overflow-hidden" open={idx === 0}>
                <summary class="group/summary min-h-[60px] px-6 sm:px-8 py-4 sm:py-5 flex items-center justify-between gap-4 cursor-pointer list-none select-none [&::-webkit-details-marker]:hidden rounded-[calc(2rem-0.375rem)] sm:rounded-[calc(2rem-0.5rem)] group-open:rounded-b-none focus-visible:outline-offset-[-2px]">
                  <span class="font-serif text-lg sm:text-xl text-olive-900 group-hover/summary:text-olive-700 transition-colors font-normal leading-snug">
                    {item.question}
                  </span>
                  <span class="w-8 h-8 rounded-full bg-linen ring-1 ring-olive-900/10 flex items-center justify-center flex-shrink-0 text-olive-800 transition-all duration-200 group-hover/summary:ring-olive-900/25 group-open:rotate-45 group-open:bg-olive-800 group-open:text-linen group-open:ring-olive-800" aria-hidden="true">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 5v14m-7-7h14"/>
                    </svg>
                  </span>
                </summary>
                <div class="px-6 sm:px-8 pb-6 pt-0 text-ink-muted font-sans text-xs sm:text-sm leading-relaxed font-light">
                  <div class="h-px w-full bg-olive-900/[0.08] mb-4" aria-hidden="true"></div>
                  <p>{item.answer}</p>
                  {item.items && item.items.length > 0 && (
                    <ul class="mt-3.5 space-y-2.5 text-ink">
                      {item.items.map((sub) => {
                        const [title, ...rest] = sub.split(' — ');
                        const detail = rest.join(' — ');
                        return (
                          <li class="flex items-start gap-2.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-gold-accent mt-2 flex-shrink-0" aria-hidden="true"></span>
                            <span>
                              {detail ? (
                                <>
                                  <strong class="font-medium text-olive-900">{title}</strong>
                                  <span class="text-ink-muted"> — {detail}</span>
                                </>
                              ) : (
                                sub
                              )}
                            </span>
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </div>
              </details>
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<script>
  const mapContainer = document.getElementById('ceremony-map-container');
  const loadMapBtn = document.getElementById('load-map-btn');

  loadMapBtn?.addEventListener('click', () => {
    const embedUrl = mapContainer?.dataset.embedUrl;
    if (!mapContainer || !embedUrl) return;

    const iframe = document.createElement('iframe');
    iframe.id = 'ceremony-maps-iframe';
    iframe.src = embedUrl;
    iframe.className = 'w-full h-full border-0';
    iframe.allowFullscreen = true;
    iframe.loading = 'eager';
    iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups');
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.title = 'Mapa do local do casamento';

    mapContainer.replaceChildren(iframe);
  });
</script>
