---
import type { CeremonyInfo } from '../../types/wedding';
import LeafIcon from '../common/LeafIcon.astro';
import { Image } from 'astro:assets';
import venueImg from '../../assets/images/cerimonia.jpeg';

interface Props {
  ceremony: CeremonyInfo;
}

const { ceremony } = Astro.props;
---

<section id="cerimonia" class="py-16 md:py-24 bg-linen-light">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Ícone de Folha Minimalista -->
    <LeafIcon />

    <h2 class="font-serif text-3xl md:text-4xl text-olive-600 mb-10 font-normal">
      {ceremony.title}
    </h2>

    <!-- Card do Local -->
    <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-[#ECE8E1] mb-8 text-left">
      <!-- Foto do Local com ambient blur leve e otimizado pelo Astro -->
      <div class="w-full h-72 sm:h-96 md:h-[460px] overflow-hidden bg-stone-900 relative flex items-center justify-center">
        <Image 
          id="ceremony-venue-bg" 
          src={venueImg} 
          alt="" 
          aria-hidden="true" 
          width={80}
          height={60}
          quality={30}
          format="webp"
          class="absolute inset-0 w-full h-full object-cover blur-2xl scale-110 opacity-35 pointer-events-none" 
        />
        <Image 
          id="ceremony-venue-photo" 
          src={venueImg} 
          alt={ceremony.venueName} 
          width={960}
          height={540}
          quality={85}
          format="webp"
          loading="lazy"
          class="relative z-10 max-h-full max-w-full object-contain md:object-cover md:w-full md:h-full md:object-center select-none" 
        />
      </div>

      <!-- Informações Detalhadas -->
      <div class="p-6 md:p-8 text-center max-w-2xl mx-auto">
        <h3 id="ceremony-venue-name" class="font-serif text-2xl md:text-3xl text-gray-800 mb-2 font-medium">
          {ceremony.venueName}
        </h3>
        <p id="ceremony-date-text" class="font-sans text-sm md:text-base text-olive-700 font-semibold mb-4">
          {ceremony.dateFormatted}, às {ceremony.time}
        </p>
        
        <p id="ceremony-notes" class="font-sans text-sm text-gray-600 leading-relaxed font-light mb-4">
          {ceremony.notes}
        </p>

        <!-- Informações de Traje & Dica da Noiva -->
        <div class="my-6 p-4 sm:p-5 rounded-2xl bg-linen-light border border-olive-100 text-center max-w-lg mx-auto space-y-2.5">
          <div>
            <span class="inline-block font-sans text-xs font-semibold uppercase tracking-wider text-olive-800">
              Traje: Casual Chique
            </span>
            <p class="font-sans text-xs text-gray-500 italic mt-0.5">
              (Pedimos apenas a gentileza de não usar trajes em tons de verde)
            </p>
          </div>
          <div class="w-8 h-px bg-olive-200/70 mx-auto"></div>
          <p class="font-sans text-xs text-gray-600 leading-relaxed">
            <strong class="text-olive-700 font-medium">✨ Dica da noiva:</strong> Meninas, o terreno é arenoso: evitem vestidos longos e salto fino; apostem no comprimento mídi e salto bloco!
          </p>
        </div>

        <p id="ceremony-address" class="font-sans text-xs md:text-sm text-gray-500 font-normal mb-6 flex items-center justify-center gap-1">
          {ceremony.address}
        </p>

        <!-- Botões de Ação para Rotas -->
        <div class="flex flex-wrap justify-center gap-3">
          <a 
            id="ceremony-maps-btn" 
            href={ceremony.mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-pill inline-flex items-center gap-2 py-2.5 px-6 bg-olive-600 hover:bg-olive-700 text-white font-sans text-xs sm:text-sm font-medium tracking-wide shadow-sm"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Abrir no Google Maps
          </a>

          <a 
            id="ceremony-waze-btn" 
            href={ceremony.wazeUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-pill inline-flex items-center gap-2 py-2.5 px-6 bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 font-sans text-xs sm:text-sm font-medium tracking-wide shadow-sm"
          >
            <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.85 7h10.29l1.04 3H5.81l1.04-3zM19 17H5v-4.66l.12-.34h13.77l.11.34V17z"/>
            </svg>
            Abrir no Waze
          </a>
        </div>
      </div>
    </div>

    <!-- Mapa Interativo Embutido -->
    <div class="w-full h-72 md:h-96 rounded-3xl overflow-hidden shadow-sm border border-[#ECE8E1] bg-gray-100">
      <iframe 
        id="ceremony-maps-iframe" 
        src={ceremony.mapsEmbedUrl} 
        class="w-full h-full border-0" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="strict-origin-when-cross-origin" 
        title="Mapa do local do casamento"
      ></iframe>
    </div>

  </div>
</section>
