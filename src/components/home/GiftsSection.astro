---
import type { GiftItem, PixConfig } from '../../types/wedding';
import { generatePixPayload } from '../../utils/pix';
import GiftCard from './GiftCard.astro';

interface Props {
  gifts: GiftItem[];
  pix: PixConfig;
}

const { gifts, pix } = Astro.props;

// Pré-gerar código PIX com valor aberto (sem campo 54) em tempo de build
const freePixPayload = generatePixPayload({
  key: pix.key,
  recipientName: pix.recipientName,
  city: pix.city,
  txid: 'PIXLIVRE'
});
---

<section id="presentes" class="py-24 md:py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="text-center max-w-2xl mx-auto mb-14 sm:mb-20 reveal-on-scroll">
    <div class="mb-4">
      <span class="eyebrow-tag">Cap. III • Mimos & Lua de Mel</span>
    </div>
    <h2 class="font-serif text-4xl md:text-5xl text-olive-900 tracking-[-0.02em] mb-5 font-normal">
      Lista de Presentes
    </h2>
    <p class="font-sans text-sm sm:text-base text-ink-muted font-light leading-[1.85]">
      Como nosso lar já está montado com muito amor, optamos por não receber presentes físicos. Criamos uma lista virtual com opções em PIX para nossa nova fase e lua de mel:
    </p>
  </div>

  <!-- Barra de Controles e PIX de Valor Livre em Double-Bezel -->
  <div class="double-bezel mb-10 reveal-on-scroll">
    <div class="double-bezel-core flex flex-col sm:flex-row items-center justify-between gap-4 px-5 py-4">
      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
        <div class="flex items-center gap-2 text-olive-800 font-sans text-xs sm:text-sm font-medium">
          <svg class="w-4 h-4 text-gold-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
          </svg>
          <span>Prefere presentear com outro valor?</span>
        </div>
        <button
          id="custom-pix-btn"
          type="button"
          data-pix-code={freePixPayload}
          class="btn-pill min-h-[44px] inline-flex items-center gap-2 py-2.5 px-5 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.16em] font-medium cursor-pointer"
        >
          Contribuir com Valor Livre
        </button>
      </div>

      <!-- Dropdown de Ordenação (Zero Auto-Zoom iOS + Hit Area 44px) -->
      <div class="flex items-center gap-2.5">
        <label for="gifts-sort-select" class="font-sans text-xs uppercase tracking-[0.16em] text-ink-subtle">Ordenar:</label>
        <select 
          id="gifts-sort-select" 
          class="font-sans text-base sm:text-sm min-h-[44px] bg-linen/80 ring-1 ring-olive-900/10 rounded-full px-4 py-1.5 text-olive-900 focus:outline-none focus:ring-olive-700 cursor-pointer"
        >
          <option value="default">Destaques</option>
          <option value="price-desc">Maior valor</option>
          <option value="price-asc">Menor valor</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Grid de Presentes -->
  <div id="gifts-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-7 sm:gap-9">
    {gifts.map(gift => (
      <GiftCard gift={gift} pix={pix} />
    ))}
  </div>
</section>

<script>
  const grid = document.getElementById('gifts-grid');
  const sortSelect = document.getElementById('gifts-sort-select') as HTMLSelectElement | null;
  const customPixBtn = document.getElementById('custom-pix-btn');

  customPixBtn?.addEventListener('click', () => {
    window.dispatchEvent(
      new CustomEvent('open-pix-modal', {
        detail: {
          title: 'Contribuição com Valor Livre',
          priceFormatted: 'Valor livre no app do seu banco',
          image: '/assets/svgs/leaf-icon.svg',
          pixCode: customPixBtn.dataset.pixCode || ''
        }
      })
    );
  });

  if (grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.gift-card'));

    grid.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLElement>('.presentear-btn');
      if (!target) return;

      const card = target.closest<HTMLElement>('.gift-card');
      if (!card) return;

      const cardImg = card.querySelector<HTMLImageElement>('.gift-card-img');

      window.dispatchEvent(
        new CustomEvent('open-pix-modal', {
          detail: {
            title: card.dataset.title || '',
            priceFormatted: card.dataset.priceFormatted || '',
            image: cardImg?.currentSrc || cardImg?.src || '',
            pixCode: card.dataset.pixCode || ''
          }
        })
      );
    });

    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value;
      const sorted = [...cards];

      if (value === 'price-asc') {
        sorted.sort((a, b) => parseFloat(a.dataset.price || '0') - parseFloat(b.dataset.price || '0'));
      } else if (value === 'price-desc') {
        sorted.sort((a, b) => parseFloat(b.dataset.price || '0') - parseFloat(a.dataset.price || '0'));
      } else {
        sorted.sort((a, b) => Number(a.dataset.id || 0) - Number(b.dataset.id || 0));
      }

      sorted.forEach(card => grid.appendChild(card));

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'animate' in grid) {
        grid.animate(
          [
            { opacity: 0.45, filter: 'blur(2px)', transform: 'translateY(6px)' },
            { opacity: 1, filter: 'blur(0px)', transform: 'translateY(0)' }
          ],
          {
            duration: 220,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)'
          }
        );
      }
    });
  }
</script>
