---
import type { PixConfig } from '../../types/wedding';
import GuestHelp from '../common/GuestHelp.astro';
interface Props { pix: PixConfig; coupleNames: string; }
const { pix, coupleNames } = Astro.props;
---

<dialog id="pix-modal" aria-labelledby="pix-modal-title" aria-describedby="pix-modal-desc"
  class="backdrop:bg-black/60 p-1.5 sm:p-2 rounded-t-3xl sm:rounded-3xl bg-linen w-full max-w-lg overflow-hidden mt-auto mb-0 sm:m-auto shadow-xl"
  data-pix-key={pix.key} data-pix-recipient={pix.recipientName} data-pix-city={pix.city}
  data-pix-whatsapp={pix.whatsappNumber} data-couple-names={coupleNames}>
  <div class="bg-white rounded-2xl flex flex-col max-h-[90dvh] overflow-hidden">
    <header class="flex items-center justify-between gap-3 px-5 py-4 border-b border-olive-900/10">
      <div>
        <h2 id="pix-modal-title" class="font-serif text-2xl text-olive-900">Presentear pelo Pix</h2>
        <p id="pix-modal-desc" class="text-base text-ink-muted">Você conclui o pagamento no seu banco.</p>
      </div>
      <button id="pix-modal-close" type="button" aria-label="Fechar janela de presente" class="min-w-[48px] min-h-[48px] rounded-full text-olive-900 hover:bg-linen flex items-center justify-center">
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </header>
    <div class="p-5 sm:p-6 overflow-y-auto space-y-5">
      <div class="flex items-start gap-3">
        <img id="pix-modal-gift-img" src="/favicon.svg" alt="" width="64" height="64" class="w-16 h-16 rounded-xl object-cover flex-shrink-0" />
        <div class="min-w-0">
          <h3 id="pix-modal-gift-title" class="font-serif text-xl text-olive-900 break-words"></h3>
          <p id="pix-modal-gift-price" class="text-lg font-medium text-gold-text tabular-nums"></p>
        </div>
      </div>
      <div class="text-base text-ink-muted bg-linen-light rounded-xl p-4">
        <p><strong class="text-olive-900">Beneficiário:</strong> <span id="pix-recipient-name">{pix.recipientName}</span></p>
        <p><strong class="text-olive-900">Banco:</strong> <span id="pix-bank-name">{pix.bank}</span></p>
        <p class="mt-2">Confira o nome e o valor no banco antes de autorizar.</p>
      </div>
      <div>
        <button id="pix-copy-btn" type="button" class="btn-pill w-full min-h-[48px] px-5 py-3 bg-olive-800 hover:bg-olive-900 text-linen text-base font-medium flex justify-center">
          <span id="pix-copy-btn-content">Copiar código Pix</span>
        </button>
        <p id="pix-next-step" role="status" aria-live="polite" class="mt-3 text-base font-medium text-olive-900">Copiar o código ainda não realiza o pagamento.</p>
      </div>
      <ol class="list-decimal pl-6 space-y-2 text-base text-ink">
        <li>Toque em <strong>Copiar código Pix</strong>.</li>
        <li>Abra o aplicativo do seu banco e escolha <strong>Pix → Pix Copia e Cola</strong>.</li>
        <li>Cole o código, confira o beneficiário e o valor e autorize no banco.</li>
      </ol>
      <details class="border-t border-olive-900/10 pt-2">
        <summary class="min-h-[48px] flex items-center cursor-pointer text-base text-olive-800 underline underline-offset-4">Ver código para copiar manualmente</summary>
        <label for="pix-copy-input" class="block text-base mt-2 mb-2">Código Pix Copia e Cola</label>
        <input type="text" id="pix-copy-input" readonly class="w-full min-h-[48px] px-3 rounded-xl bg-linen text-base font-mono select-all" />
      </details>
      <details class="border-t border-olive-900/10 pt-2">
        <summary class="min-h-[48px] flex items-center cursor-pointer text-base text-olive-800 underline underline-offset-4">Usar QR Code em outro aparelho</summary>
        <p class="text-base text-ink-muted my-3">Se o site está aberto em outro aparelho, use o leitor de QR Code do aplicativo do banco.</p>
        <img id="pix-qrcode-img" src="/favicon.svg" alt="QR Code Pix para pagamento" width="190" height="190" class="w-[190px] h-[190px] mx-auto" />
        <p id="pix-qr-status" role="status" class="text-base text-ink-muted mt-2"></p>
      </details>
      <details class="border-t border-olive-900/10 pt-2">
        <summary class="min-h-[48px] flex items-center cursor-pointer text-base text-olive-800 underline underline-offset-4">Usar somente a chave Pix</summary>
        <p class="text-base text-ink-muted my-3">Escolha Pix por chave no banco e informe também o valor que deseja enviar.</p>
        <p class="text-base break-all"><strong>Chave aleatória:</strong> <span id="pix-key-display" class="select-all">{pix.key}</span></p>
        <button id="pix-copy-raw-key-btn" type="button" class="btn-pill min-h-[48px] mt-3 px-5 py-3 bg-linen text-olive-900 ring-1 ring-olive-900/20 text-base">
          <span id="pix-copy-raw-key-text">Copiar chave Pix</span>
        </button>
      </details>
      <GuestHelp message="Olá, Tales e Camila! Preciso de orientação para presentear pelo Pix." label="Ajuda para presentear" />
      <details class="border-t border-olive-900/10 pt-2">
        <summary class="min-h-[48px] flex items-center cursor-pointer text-base text-olive-800 underline underline-offset-4">Deixar um recado aos noivos (opcional)</summary>
        <p class="text-base text-ink-muted my-3">O recado é independente do Pix e não confirma um pagamento.</p>
        <label for="pix-guest-name" class="block text-base mb-2">Seu nome</label>
        <input type="text" id="pix-guest-name" maxlength="80" autocomplete="name" class="w-full min-h-[48px] px-3 rounded-xl bg-linen text-base mb-3" />
        <label for="pix-guest-message" class="block text-base mb-2">Sua mensagem</label>
        <textarea id="pix-guest-message" rows="3" maxlength="400" class="w-full p-3 rounded-xl bg-linen text-base"></textarea>
        <button id="pix-send-whatsapp-btn" type="button" class="btn-pill w-full min-h-[48px] mt-3 px-4 py-3 bg-olive-700 text-linen text-base">Abrir recado no WhatsApp</button>
      </details>
    </div>
  </div>
</dialog>

<script>
  interface GiftModalDetail {
    title: string;
    priceFormatted: string;
    image: string;
    pixCode: string;
    isFreeAmount?: boolean;
    triggerEl?: HTMLElement | null;
  }

  let activeGift: GiftModalDetail | null = null;
  let lastTriggerEl: HTMLElement | null = null;
  let modalSession = 0;
  const qrCache = new Map<string, string>();
  let qrModulePromise: Promise<typeof import('qrcode')> | null = null;

  function loadQrModule() {
    if (!qrModulePromise) {
      qrModulePromise = import('qrcode');
    }
    return qrModulePromise;
  }

  // Pré-carregar o gerador de QR Code em tempo ocioso (Zero bloqueio da thread principal)
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => {
      void loadQrModule().catch(() => { qrModulePromise = null; });
    });
  } else {
    setTimeout(() => {
      void loadQrModule().catch(() => { qrModulePromise = null; });
    }, 1500);
  }

  async function getQrDataUrl(payload: string): Promise<string> {
    const cached = qrCache.get(payload);
    if (cached) return cached;

    const QRCode = await loadQrModule();
    const dataUrl = await QRCode.toDataURL(payload, {
      width: 380,
      margin: 1,
      color: {
        dark: '#2D3748',
        light: '#FFFFFF'
      }
    });
    qrCache.set(payload, dataUrl);
    return dataUrl;
  }

  const modal = document.getElementById('pix-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('pix-modal-close');
  const copyBtn = document.getElementById('pix-copy-btn') as HTMLButtonElement | null;
  const copyBtnContent = document.getElementById('pix-copy-btn-content');
  const copyRawKeyBtn = document.getElementById('pix-copy-raw-key-btn');
  const copyRawKeyText = document.getElementById('pix-copy-raw-key-text');
  const pixInput = document.getElementById('pix-copy-input') as HTMLInputElement | null;
  const sendWhatsappBtn = document.getElementById('pix-send-whatsapp-btn');
  const nextStep = document.getElementById('pix-next-step');
  const qrStatus = document.getElementById('pix-qr-status');

  closeBtn?.addEventListener('click', () => modal?.close());

  // Fechar ao clicar fora (backdrop nativo do <dialog>)
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  // Restaurar o foco exatamente ao botão que abriu o modal (WCAG 2.4.3 Focus Order)
  modal?.addEventListener('close', () => {
    modalSession++;
    if (lastTriggerEl && typeof lastTriggerEl.focus === 'function') {
      lastTriggerEl.focus();
    }
  });

  // Chave avulsa: o convidado informa o valor no banco.
  copyRawKeyBtn?.addEventListener('click', async () => {
    const session = modalSession;
    const rawKey = modal?.dataset.pixKey || '';
    if (!rawKey) return;
    try {
      await navigator.clipboard.writeText(rawKey);
      if (session !== modalSession || !modal?.open) return;
      if (nextStep) nextStep.textContent = 'Chave copiada. Abra o banco, escolha Pix por chave e informe o valor antes de autorizar.';
      navigator.vibrate?.(15);
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Chave PIX copiada! ✓' } }));
      if (copyRawKeyText) copyRawKeyText.textContent = 'Copiado!';
      setTimeout(() => {
        if (session === modalSession && copyRawKeyText) copyRawKeyText.textContent = 'Copiar chave Pix';
      }, 2400);
    } catch {
      if (session !== modalSession || !modal?.open) return;
      if (nextStep) nextStep.textContent = 'Não foi possível copiar. Selecione a chave abaixo para copiar manualmente ou peça ajuda.';
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Selecione e copie a chave manualmente.' } }));
    }
  });

  // A orientação persistente continua disponível depois do aviso temporário.
  copyBtn?.addEventListener('click', async () => {
    if (!activeGift || !pixInput) return;
    const session = modalSession;
    try {
      await navigator.clipboard.writeText(activeGift.pixCode);
      if (session !== modalSession || !modal?.open) return;
      if (nextStep) nextStep.textContent = 'Código copiado. Agora abra seu banco, escolha Pix Copia e Cola e cole. Confira o nome e o valor antes de autorizar.';
      navigator.vibrate?.(15);
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Código PIX copiado! Cole no app do seu banco ✓' } }));
      if (copyBtnContent) copyBtnContent.textContent = 'Copiado';
      copyBtn.classList.replace('bg-olive-800', 'bg-olive-600');
      setTimeout(() => {
        if (session !== modalSession || !modal?.open) return;
        if (copyBtnContent) copyBtnContent.textContent = 'Copiar código Pix';
        copyBtn.classList.replace('bg-olive-600', 'bg-olive-800');
      }, 2800);
    } catch {
      if (session !== modalSession || !modal?.open) return;
      pixInput.closest('details')?.setAttribute('open', '');
      pixInput.select();
      if (nextStep) nextStep.textContent = 'Não foi possível copiar automaticamente. Toque e segure no código abaixo para copiar ou peça ajuda pelo WhatsApp.';
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Toque e segure no código acima para copiar' } }));
    }
  });

  // Enviar WhatsApp com microcopy adaptado (Presente da Lista vs Valor Livre)
  sendWhatsappBtn?.addEventListener('click', () => {
    if (!activeGift || !modal) return;
    const whatsappNumber = modal.dataset.pixWhatsapp || '';
    const coupleNames = modal.dataset.coupleNames || '';
    const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
    const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;

    const guestName = (guestNameInput?.value || '').trim() || 'Um convidado querido';
    const guestMessage = (guestMessageInput?.value || '').trim();

    if (!whatsappNumber) return;

    let text = `Oi, ${coupleNames}! ❤️\n\n`;
    if (activeGift.isFreeAmount) {
      text += `Gostaria de deixar um recado com muito carinho para celebrar a nova fase de vocês.\n\n`;
    } else {
      text += `Meu recado sobre o presente da lista: *${activeGift.title}* (${activeGift.priceFormatted}).\n\n`;
    }
    if (guestMessage) {
      text += `Recado: "${guestMessage}"\n\n`;
    }
    text += `Com carinho, *${guestName}*`;

    window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
  });

  window.addEventListener('open-pix-modal', ((e: CustomEvent<GiftModalDetail>) => {
    if (!e.detail || !modal) return;
    modalSession++;
    activeGift = e.detail;
    lastTriggerEl = e.detail.triggerEl || (document.activeElement as HTMLElement | null);

    const titleEl = document.getElementById('pix-modal-gift-title');
    const priceEl = document.getElementById('pix-modal-gift-price');
    const imgEl = document.getElementById('pix-modal-gift-img') as HTMLImageElement | null;
    const qrImg = document.getElementById('pix-qrcode-img') as HTMLImageElement | null;
    const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
    const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;

    if (titleEl) titleEl.textContent = activeGift.title;
    if (priceEl) priceEl.textContent = activeGift.priceFormatted;
    if (imgEl) {
      imgEl.src = activeGift.image;
      imgEl.alt = activeGift.title ? `Foto de ${activeGift.title}` : 'Foto do presente selecionado';
    }
    if (pixInput) pixInput.value = activeGift.pixCode;
    if (guestNameInput) guestNameInput.value = '';
    if (guestMessageInput) guestMessageInput.value = '';
    if (copyBtnContent) copyBtnContent.textContent = 'Copiar código Pix';
    copyBtn?.classList.replace('bg-olive-600', 'bg-olive-800');
    if (copyRawKeyText) copyRawKeyText.textContent = 'Copiar chave Pix';
    if (nextStep) nextStep.textContent = 'Copiar o código ainda não realiza o pagamento.';
    if (qrStatus) qrStatus.textContent = 'Preparando QR Code…';
    if (qrImg) qrImg.src = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg"/%3E';

    modal.showModal();
    // Focar o botão primário de copiar código sem abrir o teclado virtual em celulares
    copyBtn?.focus();

    if (qrImg && activeGift.pixCode) {
      void getQrDataUrl(activeGift.pixCode).then((dataUrl) => {
        if (activeGift?.pixCode === e.detail.pixCode) {
          qrImg.src = dataUrl;
          if (qrStatus) qrStatus.textContent = '';
        }
      }).catch(() => {
        qrModulePromise = null;
        if (qrStatus && activeGift?.pixCode === e.detail.pixCode) qrStatus.textContent = 'Não foi possível preparar o QR Code. Use Copiar código Pix ou peça ajuda.';
      });
    }
  }) as EventListener);
</script>
