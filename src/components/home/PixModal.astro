---
import type { PixConfig } from '../../types/wedding';

interface Props {
  pix: PixConfig;
  coupleNames: string;
}

const { pix, coupleNames } = Astro.props;
---

<dialog 
  id="pix-modal" 
  class="backdrop:bg-black/60 backdrop:backdrop-blur-sm p-0 rounded-3xl shadow-2xl max-w-lg w-full bg-white border border-gray-100 overflow-hidden m-auto"
  data-pix-key={pix.key}
  data-pix-recipient={pix.recipientName}
  data-pix-city={pix.city}
  data-pix-whatsapp={pix.whatsappNumber}
  data-couple-names={coupleNames}
>
  <!-- Caixa do Modal -->
  <div class="relative w-full flex flex-col max-h-[90vh]">
    
    <!-- Cabeçalho do Modal -->
    <div class="p-5 sm:p-6 bg-linen-light border-b border-gray-200/70 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-olive-100 flex items-center justify-center text-olive-600">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif text-lg sm:text-xl text-gray-800 font-semibold leading-tight">Presentear via PIX</h3>
          <p class="font-sans text-xs text-gray-500">Transação direta e segura para os noivos</p>
        </div>
      </div>

      <button id="pix-modal-close" type="button" aria-label="Fechar modal" class="text-gray-400 hover:text-gray-600 p-2 rounded-full hover:bg-black/5 transition-colors cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Conteúdo com Scroll Interno -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-6">
      
      <!-- Resumo do Presente Selecionado -->
      <div class="flex items-center gap-4 p-4 rounded-2xl bg-linen border border-olive-100">
        <img id="pix-modal-gift-img" src="" alt="Presente" class="w-16 h-16 rounded-xl object-cover shadow-sm flex-shrink-0" />
        <div class="flex-1 min-w-0">
          <h4 id="pix-modal-gift-title" class="font-sans font-medium text-sm text-gray-800 truncate"></h4>
          <p id="pix-modal-gift-price" class="font-serif text-xl font-bold text-olive-700"></p>
        </div>
      </div>

      <!-- QR Code Dinâmico -->
      <div class="text-center">
        <p class="font-sans text-xs text-gray-500 mb-3">Abra o app do seu banco e escaneie o código abaixo:</p>
        <div id="pix-qrcode-container" class="flex justify-center items-center min-h-[190px] p-2 bg-white rounded-2xl border border-gray-100 inline-block mx-auto shadow-sm">
          <!-- QR Code inserido aqui dinamicamente -->
        </div>
      </div>

      <!-- Código PIX Copia e Cola -->
      <div>
        <label class="block font-sans text-xs font-semibold text-gray-700 uppercase tracking-wider mb-2">
          Ou use o PIX Copia e Cola:
        </label>
        <div class="flex items-center gap-2">
          <input 
            type="text" 
            id="pix-copy-input" 
            readonly 
            class="w-full font-mono text-xs p-3 rounded-xl bg-linen border border-gray-200 text-gray-600 focus:outline-none select-all"
          />
          <button 
            type="button" 
            id="pix-copy-btn" 
            class="btn-pill flex-shrink-0 px-4 py-3 bg-olive-600 hover:bg-olive-700 text-white font-sans text-xs font-semibold tracking-wide whitespace-nowrap shadow-sm transition-colors cursor-pointer"
          >
            Copiar Código
          </button>
        </div>
      </div>

      <!-- Detalhes do Favorecido -->
      <div class="text-xs text-gray-500 bg-gray-50 p-3.5 rounded-xl space-y-1">
        <p><span class="font-semibold text-gray-700">Beneficiário:</span> <span id="pix-recipient-name">{pix.recipientName}</span></p>
        <p><span class="font-semibold text-gray-700">Banco:</span> <span id="pix-bank-name">{pix.bank}</span></p>
        <p><span class="font-semibold text-gray-700">Chave PIX:</span> <span id="pix-key-display">{pix.key}</span></p>
      </div>

      <!-- Área de Envio de Recado via WhatsApp -->
      <div class="border-t border-gray-100 pt-5">
        <h5 class="font-sans text-xs font-semibold uppercase tracking-wider text-gray-700 mb-2">
          Deixar um recado aos noivos:
        </h5>
        <div class="space-y-3">
          <input 
            type="text" 
            id="pix-guest-name" 
            placeholder="Seu nome" 
            class="w-full font-sans text-xs px-3.5 py-2.5 rounded-xl border border-gray-200 bg-linen focus:bg-white focus:outline-none focus:border-olive-600"
          />
          <textarea 
            id="pix-guest-message" 
            rows="2" 
            placeholder="Escreva uma mensagem especial de felicitações..." 
            class="w-full font-sans text-xs px-3.5 py-2.5 rounded-xl border border-gray-200 bg-linen focus:bg-white focus:outline-none focus:border-olive-600 resize-none"
          ></textarea>
          <button 
            type="button" 
            id="pix-send-whatsapp-btn" 
            class="w-full py-2.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-sans text-xs font-medium tracking-wide flex items-center justify-center gap-2 transition-colors shadow-sm cursor-pointer"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            Enviar Recado aos Noivos no WhatsApp
          </button>
        </div>
      </div>

    </div>

  </div>
</dialog>

<script>
  import { generatePixPayload } from '../../utils/pix';
  import { formatCurrency } from '../../utils/currency';
  import QRCode from 'qrcode';

  interface GiftPayload {
    id: number;
    title: string;
    price: number;
    image: string;
    description?: string;
  }

  let activeGift: GiftPayload | null = null;
  let activePixCode = '';

  const modal = document.getElementById('pix-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('pix-modal-close');
  const copyBtn = document.getElementById('pix-copy-btn');
  const pixInput = document.getElementById('pix-copy-input') as HTMLInputElement | null;
  const sendWhatsappBtn = document.getElementById('pix-send-whatsapp-btn');

  const pixKey = modal?.dataset.pixKey || '';
  const recipientName = modal?.dataset.pixRecipient || '';
  const city = modal?.dataset.pixCity || 'SAO MIGUEL DO GUAMA';
  const whatsappNumber = modal?.dataset.pixWhatsapp || '';
  const coupleNames = modal?.dataset.coupleNames || '';

  function closeModal() {
    if (modal?.open) {
      modal.close();
    }
  }

  if (closeBtn) closeBtn.addEventListener('click', closeModal);

  // Fechar ao clicar fora (backdrop nativo)
  modal?.addEventListener('click', (e) => {
    if (!modal) return;
    const rect = modal.getBoundingClientRect();
    const isInDialog = (
      rect.top <= e.clientY &&
      e.clientY <= rect.top + rect.height &&
      rect.left <= e.clientX &&
      e.clientX <= rect.left + rect.width
    );
    if (!isInDialog) {
      modal.close();
    }
  });

  // Copiar código PIX com Clipboard API moderna
  if (copyBtn && pixInput) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(activePixCode);
        (window as any).showToast?.('Código PIX copiado com sucesso! ✓');
        copyBtn.textContent = 'Copiado!';
        copyBtn.classList.replace('bg-olive-600', 'bg-emerald-600');
        setTimeout(() => {
          copyBtn.textContent = 'Copiar Código';
          copyBtn.classList.replace('bg-emerald-600', 'bg-olive-600');
        }, 3000);
      } catch {
        pixInput.select();
        (window as any).showToast?.('Selecione e copie o código acima');
      }
    });
  }

  // Enviar WhatsApp
  if (sendWhatsappBtn) {
    sendWhatsappBtn.addEventListener('click', () => {
      if (!activeGift) return;
      const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
      const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;

      const guestName = (guestNameInput?.value || '').trim() || 'Um convidado querido';
      const guestMessage = (guestMessageInput?.value || '').trim();

      if (!whatsappNumber) {
        alert('Número de WhatsApp não configurado.');
        return;
      }

      let text = `Olá ${coupleNames}! ❤️\n\n`;
      text += `Acabei de escolher o presente: *${activeGift.title}* (${formatCurrency(activeGift.price)}) na lista de vocês!\n\n`;
      if (guestMessage) {
        text += `Mensagem com carinho: "${guestMessage}"\n\n`;
      }
      text += `Abraços de: *${guestName}*`;

      const encoded = encodeURIComponent(text);
      window.open(`https://wa.me/${whatsappNumber}?text=${encoded}`, '_blank');
    });
  }

  async function openModal(gift: GiftPayload) {
    activeGift = gift;
    if (!modal) return;

    const titleEl = document.getElementById('pix-modal-gift-title');
    const priceEl = document.getElementById('pix-modal-gift-price');
    const imgEl = document.getElementById('pix-modal-gift-img') as HTMLImageElement | null;
    const qrContainer = document.getElementById('pix-qrcode-container');

    if (titleEl) titleEl.textContent = gift.title;
    if (priceEl) priceEl.textContent = formatCurrency(gift.price);
    if (imgEl) imgEl.src = gift.image;

    // Gerar Payload PIX oficial
    activePixCode = generatePixPayload({
      key: pixKey,
      recipientName: recipientName,
      city: city,
      amount: gift.price,
      txid: `GIFT${gift.id}`
    });

    if (pixInput) pixInput.value = activePixCode;

    // Gerar QR Code
    if (qrContainer) {
      qrContainer.innerHTML = '';
      try {
        const qrDataUrl = await QRCode.toDataURL(activePixCode, {
          width: 190,
          margin: 1,
          color: {
            dark: '#2D3748',
            light: '#FFFFFF'
          }
        });
        qrContainer.innerHTML = `<img src="${qrDataUrl}" alt="QR Code PIX" class="w-[190px] h-[190px] mx-auto rounded-lg shadow-sm border border-gray-100" />`;
      } catch {
        const fallbackUrl = `https://api.qrserver.com/v1/create-qr-code/?size=190x190&margin=4&data=${encodeURIComponent(activePixCode)}`;
        qrContainer.innerHTML = `<img src="${fallbackUrl}" alt="QR Code PIX" class="w-[190px] h-[190px] mx-auto rounded-lg shadow-sm border border-gray-100" />`;
      }
    }

    // Limpar campos de recado
    const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
    const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;
    if (guestNameInput) guestNameInput.value = '';
    if (guestMessageInput) guestMessageInput.value = '';

    // Abertura nativa acessível via dialog API
    modal.showModal();
  }

  // Ouvinte de evento desacoplado
  window.addEventListener('open-pix-modal', ((e: CustomEvent<GiftPayload>) => {
    if (e.detail) {
      openModal(e.detail);
    }
  }) as EventListener);

  // Compatibilidade com window.openPixModal
  (window as any).openPixModal = openModal;
</script>
