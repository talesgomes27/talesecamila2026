---
import type { PixConfig } from '../../types/wedding';

interface Props {
  pix: PixConfig;
  coupleNames: string;
}

const { pix, coupleNames } = Astro.props;
---

<dialog 
  id="pix-modal" 
  aria-labelledby="pix-modal-title"
  aria-describedby="pix-modal-desc"
  class="backdrop:bg-black/60 backdrop:backdrop-blur-sm p-1.5 sm:p-2 pb-[max(0.375rem,env(safe-area-inset-bottom))] sm:pb-2 rounded-t-[2rem] rounded-b-none sm:rounded-[2rem] bg-linen/90 ring-1 ring-olive-900/15 shadow-[0_32px_64px_-16px_rgba(29,44,30,0.35)] max-w-full sm:max-w-lg w-full overflow-hidden mt-auto mb-0 mx-auto sm:m-auto"
  data-pix-key={pix.key}
  data-pix-recipient={pix.recipientName}
  data-pix-city={pix.city}
  data-pix-whatsapp={pix.whatsappNumber}
  data-couple-names={coupleNames}
>
  <!-- Caixa Interna do Modal (Double-Bezel Core) -->
  <div class="double-bezel-core rounded-b-none sm:rounded-[calc(2rem-0.5rem)] relative w-full flex flex-col max-h-[90dvh] sm:max-h-[88vh] overflow-hidden">
    
    <!-- Indicador de Bottom Sheet no Mobile (Affordance Visual) -->
    <div class="w-10 h-1 rounded-full bg-olive-900/15 mx-auto mt-2.5 mb-0.5 sm:hidden flex-shrink-0" aria-hidden="true"></div>

    <!-- Cabeçalho do Modal -->
    <div class="px-5 py-4 sm:p-6 bg-linen-light/80 border-b border-olive-900/[0.06] flex items-center justify-between">
      <div class="flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-full bg-olive-900/[0.06] ring-1 ring-olive-900/10 flex items-center justify-center text-olive-800 flex-shrink-0" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div>
          <h3 id="pix-modal-title" class="font-serif text-xl sm:text-2xl text-olive-900 font-normal leading-tight">Presentear via PIX</h3>
          <p id="pix-modal-desc" class="font-sans text-xs text-ink-muted font-light">Seu carinho vai direto para a nossa nova fase</p>
        </div>
      </div>

      <!-- Hit Area 44x44px (Lei de Fitts / WCAG 2.5.8) -->
      <button id="pix-modal-close" type="button" aria-label="Fechar janela de presente" class="w-11 h-11 -mr-1.5 text-ink-subtle hover:text-olive-900 rounded-full hover:bg-olive-900/5 active:scale-95 flex items-center justify-center transition-[transform,color,background-color] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] cursor-pointer flex-shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Conteúdo com Scroll Interno -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-5 sm:space-y-6">
      
      <!-- Resumo do Presente Selecionado -->
      <div class="flex items-center gap-4 p-4 rounded-2xl bg-linen/80 ring-1 ring-olive-900/[0.08]">
        <img 
          id="pix-modal-gift-img" 
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" 
          alt="Foto do presente selecionado" 
          width="64"
          height="64"
          class="w-16 h-16 rounded-xl object-cover ring-1 ring-black/5 flex-shrink-0" 
        />
        <div class="flex-1 min-w-0">
          <h4 id="pix-modal-gift-title" class="font-serif text-base sm:text-lg text-olive-900 font-normal truncate"></h4>
          <p id="pix-modal-gift-price" class="font-serif text-xl sm:text-2xl font-normal text-gold-text"></p>
        </div>
      </div>

      <!-- QR Code em Alta Definição (Retina 2x) + Orientação Contextual Mobile vs Desktop -->
      <div class="text-center">
        <p class="font-sans text-xs text-ink-muted mb-3 font-light sm:hidden">
          No celular, toque em <strong class="font-medium text-olive-900">Copiar Código</strong> abaixo e cole na área <strong class="font-medium text-olive-900">PIX Copia e Cola</strong> do seu banco:
        </p>
        <p class="font-sans text-xs text-ink-muted mb-3 font-light hidden sm:block">
          Aponte a câmera do app do seu banco para o QR Code ou use o código abaixo:
        </p>
        <div class="inline-flex justify-center items-center min-h-[176px] sm:min-h-[190px] p-3 bg-white rounded-2xl ring-1 ring-olive-900/10 mx-auto">
          <img 
            id="pix-qrcode-img" 
            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" 
            alt="QR Code PIX para pagamento" 
            width="190" 
            height="190" 
            class="w-[170px] h-[170px] sm:w-[190px] sm:h-[190px] mx-auto rounded-lg" 
          />
        </div>
      </div>

      <!-- Código PIX Copia e Cola (Na Zona do Polegar + Zero Auto-Zoom iOS com text-base sm:text-xs) -->
      <div>
        <label for="pix-copy-input" class="block font-sans text-[11px] font-medium text-ink-muted uppercase tracking-[0.18em] mb-2">
          Código PIX Copia e Cola:
        </label>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5">
          <input 
            type="text" 
            id="pix-copy-input" 
            readonly 
            class="w-full font-mono text-base sm:text-xs min-h-[48px] px-3.5 py-2.5 rounded-xl bg-linen ring-1 ring-olive-900/10 text-ink-muted select-all"
          />
          <button 
            type="button" 
            id="pix-copy-btn" 
            class="btn-pill flex-shrink-0 min-h-[48px] min-w-[152px] justify-center px-5 py-3 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs uppercase tracking-[0.15em] font-medium whitespace-nowrap inline-flex items-center cursor-pointer"
          >
            <span id="pix-copy-btn-content" class="blur-bridge">Copiar Código</span>
          </button>
        </div>
      </div>

      <!-- Detalhes do Favorecido -->
      <div class="text-xs text-ink-muted bg-linen-light/70 p-4 rounded-xl ring-1 ring-olive-900/[0.06] space-y-1 font-light">
        <p><span class="font-medium text-olive-900">Beneficiário:</span> <span id="pix-recipient-name">{pix.recipientName}</span></p>
        <p><span class="font-medium text-olive-900">Banco:</span> <span id="pix-bank-name">{pix.bank}</span></p>
        <p><span class="font-medium text-olive-900">Chave PIX:</span> <span id="pix-key-display">{pix.key}</span></p>
      </div>

      <!-- Área de Envio de Recado via WhatsApp (Inputs com Labels Semânticos + Zero Auto-Zoom iOS) -->
      <div class="border-t border-olive-900/[0.06] pt-5">
        <h5 class="font-sans text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted mb-2.5">
          Avisar os noivos e deixar um recado:
        </h5>
        <div class="space-y-3">
          <div>
            <label for="pix-guest-name" class="sr-only">Seu nome</label>
            <input 
              type="text" 
              id="pix-guest-name" 
              placeholder="Seu nome (ex.: Tio Carlos e família)" 
              maxlength="80"
              autocomplete="name"
              class="w-full font-sans text-base sm:text-xs min-h-[48px] px-4 py-3 rounded-xl ring-1 ring-olive-900/10 bg-linen focus:bg-white focus:ring-olive-700 transition-colors placeholder:text-[#5F6359]"
            />
          </div>
          <div>
            <label for="pix-guest-message" class="sr-only">Sua mensagem de carinho para os noivos</label>
            <textarea 
              id="pix-guest-message" 
              rows="2" 
              maxlength="400"
              placeholder="Escreva uma mensagem especial de felicitações..." 
              class="w-full font-sans text-base sm:text-xs px-4 py-3 rounded-xl ring-1 ring-olive-900/10 bg-linen focus:bg-white focus:ring-olive-700 transition-colors resize-none placeholder:text-[#5F6359]"
            ></textarea>
          </div>
          <button 
            type="button" 
            id="pix-send-whatsapp-btn" 
            class="btn-pill w-full min-h-[48px] py-3 px-5 bg-olive-700 hover:bg-olive-800 text-linen font-sans text-xs uppercase tracking-[0.16em] font-medium flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
            </svg>
            Enviar Recado no WhatsApp
          </button>
        </div>
      </div>

    </div>

  </div>
</dialog>

<script>
  interface GiftModalDetail {
    title: string;
    priceFormatted: string;
    image: string;
    pixCode: string;
    isFreeAmount?: boolean;
    triggerEl?: HTMLElement | null;
  }

  let activeGift: GiftModalDetail | null = null;
  let lastTriggerEl: HTMLElement | null = null;
  const qrCache = new Map<string, string>();
  let qrModulePromise: Promise<typeof import('qrcode')> | null = null;

  function loadQrModule() {
    if (!qrModulePromise) {
      qrModulePromise = import('qrcode');
    }
    return qrModulePromise;
  }

  // Pré-carregar o gerador de QR Code em tempo ocioso (Zero bloqueio da thread principal)
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => {
      void loadQrModule();
    });
  } else {
    setTimeout(() => {
      void loadQrModule();
    }, 1500);
  }

  async function getQrDataUrl(payload: string): Promise<string> {
    const cached = qrCache.get(payload);
    if (cached) return cached;

    const QRCode = await loadQrModule();
    const dataUrl = await QRCode.toDataURL(payload, {
      width: 380,
      margin: 1,
      color: {
        dark: '#2D3748',
        light: '#FFFFFF'
      }
    });
    qrCache.set(payload, dataUrl);
    return dataUrl;
  }

  const modal = document.getElementById('pix-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('pix-modal-close');
  const copyBtn = document.getElementById('pix-copy-btn') as HTMLButtonElement | null;
  const copyBtnContent = document.getElementById('pix-copy-btn-content');
  const pixInput = document.getElementById('pix-copy-input') as HTMLInputElement | null;
  const sendWhatsappBtn = document.getElementById('pix-send-whatsapp-btn');

  function switchButtonLabel(el: HTMLElement | null, newText: string) {
    if (!el) return;
    el.classList.add('is-switching');
    setTimeout(() => {
      el.textContent = newText;
      el.classList.remove('is-switching');
    }, 130);
  }

  closeBtn?.addEventListener('click', () => modal?.close());

  // Fechar ao clicar fora (backdrop nativo do <dialog>)
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  // Restaurar o foco exatamente ao botão que abriu o modal (WCAG 2.4.3 Focus Order)
  modal?.addEventListener('close', () => {
    if (lastTriggerEl && typeof lastTriggerEl.focus === 'function') {
      lastTriggerEl.focus();
    }
  });

  // Copiar código PIX com Clipboard API moderna + Blur Bridge + Haptic Feedback
  copyBtn?.addEventListener('click', async () => {
    if (!activeGift || !pixInput) return;
    try {
      await navigator.clipboard.writeText(activeGift.pixCode);
      navigator.vibrate?.(15);
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Código PIX copiado! Cole no app do seu banco ✓' } }));
      switchButtonLabel(copyBtnContent, 'Copiado ✓');
      copyBtn.classList.replace('bg-olive-800', 'bg-olive-600');
      setTimeout(() => {
        switchButtonLabel(copyBtnContent, 'Copiar Código');
        copyBtn.classList.replace('bg-olive-600', 'bg-olive-800');
      }, 2800);
    } catch {
      pixInput.select();
      window.dispatchEvent(new CustomEvent('site-toast', { detail: { message: 'Toque e segure no código acima para copiar' } }));
    }
  });

  // Enviar WhatsApp com microcopy adaptado (Presente da Lista vs Valor Livre)
  sendWhatsappBtn?.addEventListener('click', () => {
    if (!activeGift || !modal) return;
    const whatsappNumber = modal.dataset.pixWhatsapp || '';
    const coupleNames = modal.dataset.coupleNames || '';
    const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
    const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;

    const guestName = (guestNameInput?.value || '').trim() || 'Um convidado querido';
    const guestMessage = (guestMessageInput?.value || '').trim();

    if (!whatsappNumber) return;

    let text = `Oi, ${coupleNames}! ❤️\n\n`;
    if (activeGift.isFreeAmount) {
      text += `Acabei de enviar um presente via PIX com muito carinho para celebrar a nova fase de vocês!\n\n`;
    } else {
      text += `Acabei de enviar um mimo da lista para vocês: *${activeGift.title}* (${activeGift.priceFormatted}).\n\n`;
    }
    if (guestMessage) {
      text += `Recado: "${guestMessage}"\n\n`;
    }
    text += `Com carinho, *${guestName}*`;

    window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
  });

  window.addEventListener('open-pix-modal', ((e: CustomEvent<GiftModalDetail>) => {
    if (!e.detail || !modal) return;
    activeGift = e.detail;
    lastTriggerEl = e.detail.triggerEl || (document.activeElement as HTMLElement | null);

    const titleEl = document.getElementById('pix-modal-gift-title');
    const priceEl = document.getElementById('pix-modal-gift-price');
    const imgEl = document.getElementById('pix-modal-gift-img') as HTMLImageElement | null;
    const qrImg = document.getElementById('pix-qrcode-img') as HTMLImageElement | null;
    const guestNameInput = document.getElementById('pix-guest-name') as HTMLInputElement | null;
    const guestMessageInput = document.getElementById('pix-guest-message') as HTMLTextAreaElement | null;

    if (titleEl) titleEl.textContent = activeGift.title;
    if (priceEl) priceEl.textContent = activeGift.priceFormatted;
    if (imgEl) {
      imgEl.src = activeGift.image;
      imgEl.alt = activeGift.title ? `Foto de ${activeGift.title}` : 'Foto do presente selecionado';
    }
    if (pixInput) pixInput.value = activeGift.pixCode;
    if (guestNameInput) guestNameInput.value = '';
    if (guestMessageInput) guestMessageInput.value = '';

    modal.showModal();
    // Focar o botão primário de copiar código sem abrir o teclado virtual em celulares
    copyBtn?.focus();

    if (qrImg && activeGift.pixCode) {
      void getQrDataUrl(activeGift.pixCode).then((dataUrl) => {
        if (activeGift?.pixCode === e.detail.pixCode) {
          qrImg.src = dataUrl;
        }
      });
    }
  }) as EventListener);
</script>
