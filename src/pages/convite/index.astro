---
import InvitationLayout from '../../layouts/InvitationLayout.astro';
import LeafIcon from '../../components/common/LeafIcon.astro';
import { Image } from 'astro:assets';
import coupleHeroImg from '../../assets/images/casal.jpg';
import { weddingData, calendarLinks } from '../../data/weddingData';
const coupleNames = weddingData.couple.names;
const address = weddingData.ceremony.address;
const time = weddingData.ceremony.time;
const mapsUrl = weddingData.ceremony.mapsUrl;
---

<InvitationLayout>
  <!-- Barra de Ações Superior (Mobile / Web, Hit Area >= 44px) -->
  <div class="no-print w-full max-w-xl mb-3 flex items-center justify-start text-xs text-ink-muted px-2">
    <a href="/" class="min-h-[44px] inline-flex items-center gap-2 font-sans text-[11px] uppercase tracking-[0.18em] font-medium hover:text-olive-800 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Ir para o site do casamento
    </a>
  </div>

  <!-- Cartão do Convite (Papelaria Fina Emoldurada) -->
  <main class="invitation-card relative w-full max-w-xl bg-[#FAF8F5] rounded-[2rem] p-7 sm:p-12 card-border overflow-hidden">
    
    <!-- Ilustrações Botânicas nos Cantos -->
    <div class="absolute -top-6 -left-6 w-28 sm:w-36 pointer-events-none opacity-35 select-none" aria-hidden="true">
      <img src="/assets/svgs/botanical-branch.svg" alt="" width="144" height="216" decoding="async" class="w-full h-auto" />
    </div>

    <div class="absolute -bottom-8 -right-8 w-28 sm:w-36 pointer-events-none opacity-35 select-none rotate-180" aria-hidden="true">
      <img src="/assets/svgs/botanical-branch.svg" alt="" width="144" height="216" decoding="async" class="w-full h-auto" />
    </div>

    <div class="relative z-10 text-center">
      
      <!-- Monograma / Iniciais (Sem faux-bold) -->
      <div class="inline-flex items-center justify-center mb-4 border-b border-gold-accent/30 pb-2 px-4">
        <span class="font-serif text-2xl sm:text-3xl text-olive-900 font-normal tracking-widest">{weddingData.couple.groom.charAt(0)}</span>
        <span class="font-serif italic text-xl text-gold-accent font-normal mx-2.5">&</span>
        <span class="font-serif text-2xl sm:text-3xl text-olive-900 font-normal tracking-widest">{weddingData.couple.bride.charAt(0)}</span>
      </div>

      <!-- Versículo / Mensagem de Abertura -->
      <p class="font-serif italic text-base sm:text-lg text-ink-muted font-normal max-w-md mx-auto mb-5 leading-relaxed px-2">
        “E quem um dia irá dizer que existe razão nas coisas feitas pelo coração? E quem irá dizer que não existe razão…”
      </p>

      <!-- Texto Institucional do Convite -->
      <p class="font-sans text-xs text-ink-muted font-light max-w-md mx-auto mb-6 leading-relaxed tracking-wide px-2">
        Convidamos você para compartilhar esse momento tão nosso, repleto de amor, simplicidade e carinho:
      </p>

      <!-- Nomes dos Noivos (Escala Editorial Sem Faux-Bold) -->
      <h1 class="font-serif text-5xl sm:text-6xl text-olive-900 font-normal tracking-[-0.025em] leading-[0.95] mb-2">
        {weddingData.couple.groom}
        <span class="block font-serif italic text-2xl sm:text-3xl text-gold-accent font-normal my-1.5">&</span>
        {weddingData.couple.bride}
      </h1>

      <!-- Ícone Folha Minimalista -->
      <div class="w-8 h-4 mx-auto my-4 opacity-75">
        <LeafIcon />
      </div>

      <!-- Foto dos Noivos com Moldura Orgânica -->
      <div class="my-7 flex justify-center">
        <div class="relative w-40 h-40 sm:w-48 sm:h-48">
          <!-- Folhagens decorativas ao redor da moldura -->
          <div class="absolute -inset-5 pointer-events-none z-10 opacity-75 select-none" aria-hidden="true">
            <img src="/assets/svgs/hero-frame-leaves.svg" alt="" width="240" height="240" decoding="async" class="w-full h-full object-contain" />
          </div>

          <div class="organic-hero-frame w-full h-full overflow-hidden p-1.5 bg-white/80 ring-1 ring-olive-900/10 relative z-0">
            <Image 
              src={coupleHeroImg} 
              alt={coupleNames} 
              width={384}
              height={384}
              quality={85}
              format="webp"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover rounded-[inherit] select-none"
            />
          </div>
        </div>
      </div>

      <!-- Data e Horário em Destaque Editorial -->
      <div class="my-7 py-4 border-y border-gold-accent/40 max-w-md mx-auto">
        <p class="font-sans text-[11px] tracking-[0.28em] uppercase text-gold-accent font-medium mb-1.5">
          Sábado
        </p>
        <p class="font-serif text-2xl sm:text-3xl md:text-4xl text-olive-900 tracking-wider font-normal">
          19 | DEZEMBRO | 2026
        </p>
        <p class="font-sans text-[11px] tracking-[0.28em] text-ink-muted font-medium mt-1.5 uppercase">
          ÀS {time}
        </p>
      </div>

      <!-- Local da Cerimônia e Recepção -->
      <div class="mb-7">
        <p class="font-serif text-2xl sm:text-3xl text-olive-900 font-normal mb-1">
          Beira Rio
        </p>
        <p class="font-serif italic text-base text-gold-accent font-normal mb-2">
          (No antigo Empresa Bar)
        </p>
        <p class="font-sans text-xs text-ink-muted font-light max-w-xs mx-auto leading-relaxed">
          {address}
        </p>
      </div>

      <!-- Às margens do Rio Guamá -->
      <div class="my-6 max-w-md mx-auto px-4">
        <p class="font-serif italic text-base sm:text-lg text-olive-900 font-normal leading-relaxed">
          “Às margens do rio Guamá, onde o tempo desacelera e a vida encontra seu melhor curso, escolhemos celebrar o amor.”
        </p>
      </div>

      <!-- Informações Úteis / Traje & Dica da Noiva -->
      <div class="my-7 p-5 sm:p-6 rounded-2xl bg-white/80 ring-1 ring-olive-900/10 text-center max-w-sm mx-auto space-y-3.5">
        <div>
          <span class="inline-block font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-olive-900 mb-1">
            Traje: Casual Chique
          </span>
          <p class="font-serif italic text-xs sm:text-sm text-ink-muted">
            (Pedimos a gentileza de não usar trajes em tons de verde e/ou branco)
          </p>
        </div>

        <div class="w-12 h-px bg-gold-accent/35 mx-auto"></div>

        <div>
          <p class="font-sans text-[11px] font-medium uppercase tracking-[0.2em] text-gold-accent mb-1.5">
            Nota da Noiva
          </p>
          <p class="font-sans text-xs text-ink-muted font-light leading-relaxed">
            Meninas, o terreno é arenoso: evitem vestidos longos e salto fino; apostem no comprimento mídi e salto bloco!
          </p>
        </div>
      </div>

      <!-- Divisor Sutil -->
      <div class="w-16 h-px bg-gold-accent/40 mx-auto my-6"></div>

      <!-- Botões de Ação Digital (Hit Areas >= 44-48px na Zona do Polegar) -->
      <div class="no-print space-y-2.5 max-w-sm mx-auto">
        <!-- Botão Acessar Site (Button-in-Button, 48px) -->
        <a 
          href="/" 
          class="btn-pill w-full min-h-[48px] py-2 pl-6 pr-2 bg-olive-800 hover:bg-olive-900 text-linen font-sans text-xs font-medium tracking-[0.18em] uppercase flex items-center justify-between group cursor-pointer"
        >
          <span class="mx-auto pl-4">Acessar Site & Presentes</span>
          <span class="btn-trailing-icon w-9 h-9 rounded-full bg-white/10 flex items-center justify-center transition-[transform,background-color] duration-200 ease-[cubic-bezier(0.23,1,0.32,1)]">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 17L17 7M17 7H8M17 7V16"/>
            </svg>
          </span>
        </a>

        <div class="grid grid-cols-2 gap-2.5">
          <!-- Botão Confirmar Presença -->
          <a 
            href="/#rsvp" 
            class="btn-pill min-h-[44px] py-2.5 px-3 bg-white hover:bg-linen ring-1 ring-olive-900/15 text-olive-900 font-sans text-[11px] uppercase tracking-[0.14em] font-medium flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-olive-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
            </svg>
            Confirmar RSVP
          </a>

          <!-- Botão Como Chegar (Maps) -->
          <a 
            href={mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-pill min-h-[44px] py-2.5 px-3 bg-white hover:bg-linen ring-1 ring-olive-900/15 text-olive-900 font-sans text-[11px] uppercase tracking-[0.14em] font-medium flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-gold-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Como Chegar
          </a>
        </div>

        <!-- Botões de Calendário (Google e Apple/iCal) -->
        <div class="grid grid-cols-2 gap-2.5">
          <a 
            id="btn-add-calendar"
            href={calendarLinks.googleUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-pill w-full min-h-[44px] py-2.5 px-3 bg-linen hover:bg-linen-dark text-ink-muted font-sans text-[11px] uppercase tracking-[0.14em] font-medium flex items-center justify-center gap-1.5 ring-1 ring-olive-900/10"
          >
            <svg class="w-3.5 h-3.5 text-olive-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Google Agenda
          </a>

          <a 
            id="btn-add-ical"
            href={calendarLinks.icsDataUri} 
            download="casamento-tales-e-camila.ics"
            class="btn-pill w-full min-h-[44px] py-2.5 px-3 bg-linen hover:bg-linen-dark text-ink-muted font-sans text-[11px] uppercase tracking-[0.14em] font-medium flex items-center justify-center gap-1.5 ring-1 ring-olive-900/10"
          >
            <svg class="w-3.5 h-3.5 text-olive-700 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.63 1.35-.57.66-.97 1.73-.84 2.76 1 .08 2.03-.51 2.55-1.26z"/>
            </svg>
            Apple / iCal
          </a>
        </div>
      </div>

    </div>
  </main>

  <!-- Rodapé do Convite -->
  <footer class="no-print mt-6 text-center text-xs text-ink-subtle font-serif italic">
    <p>Com carinho, {coupleNames}</p>
  </footer>
</InvitationLayout>
