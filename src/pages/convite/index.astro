---
import InvitationLayout from '../../layouts/InvitationLayout.astro';
import LeafIcon from '../../components/common/LeafIcon.astro';
import { weddingData } from '../../data/weddingData';

const siteUrl = weddingData.meta.siteUrl;
const coupleNames = weddingData.couple.names;
const venue = weddingData.ceremony.venueName;
const address = weddingData.ceremony.address;
const time = weddingData.ceremony.time;
const dateFormatted = weddingData.ceremony.dateFormatted;
const mapsUrl = weddingData.ceremony.mapsUrl;
---

<InvitationLayout>
  <!-- Barra de Ações Superior (Mobile / Web) -->
  <div class="no-print w-full max-w-xl mb-4 flex items-center justify-between text-xs text-gray-600 px-2">
    <a href="/" class="inline-flex items-center gap-1.5 font-medium hover:text-olive-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Ir para o site do casamento
    </a>

    <button onclick="window.print()" class="inline-flex items-center gap-1.5 font-medium hover:text-olive-700 transition-colors bg-white/80 px-3 py-1.5 rounded-full border border-gray-200 shadow-sm cursor-pointer">
      <svg class="w-4 h-4 text-olive-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Imprimir / Salvar PDF
    </button>
  </div>

  <!-- Cartão do Convite -->
  <main class="invitation-card relative w-full max-w-xl bg-[#FAF8F5] rounded-3xl shadow-2xl p-6 sm:p-10 card-border overflow-hidden">
    
    <!-- Ilustrações Botânicas nos Cantos -->
    <div class="absolute -top-6 -left-6 w-28 sm:w-36 pointer-events-none opacity-40 select-none">
      <img src="/assets/svgs/botanical-branch.svg" alt="Ramo floral" class="w-full h-auto" />
    </div>

    <div class="absolute -bottom-8 -right-8 w-28 sm:w-36 pointer-events-none opacity-40 select-none rotate-180">
      <img src="/assets/svgs/botanical-branch.svg" alt="Ramo floral" class="w-full h-auto" />
    </div>

    <div class="relative z-10 text-center">
      
      <!-- Monograma / Iniciais -->
      <div class="inline-flex items-center justify-center mb-3">
        <span class="font-serif text-2xl text-olive-700 tracking-wider">{weddingData.couple.groom.charAt(0)}</span>
        <span class="font-cormorant italic text-lg text-gold-accent mx-1.5">&</span>
        <span class="font-serif text-2xl text-olive-700 tracking-wider">{weddingData.couple.bride.charAt(0)}</span>
      </div>

      <!-- Versículo / Mensagem de Abertura -->
      <p class="font-cormorant italic text-sm sm:text-base text-gray-500 max-w-md mx-auto mb-5 leading-relaxed">
        "O amor é paciente, o amor é bondoso. Tudo sofre, tudo crê, tudo espera, tudo suporta."
      </p>

      <!-- Texto Institucional do Convite -->
      <p class="font-sans text-[11px] sm:text-xs tracking-[0.25em] uppercase text-gray-500 font-medium mb-4">
        Com a bênção de Deus e de nossas famílias, convidamos para o casamento de
      </p>

      <!-- Nomes dos Noivos -->
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-800 tracking-tight leading-none mb-1">
        {weddingData.couple.groom}
        <span class="block font-cormorant italic text-2xl sm:text-3xl text-gold-accent my-1">&</span>
        {weddingData.couple.bride}
      </h1>

      <!-- Ícone Folha Minimalista -->
      <div class="w-8 h-4 mx-auto my-3 opacity-75">
        <LeafIcon />
      </div>

      <!-- Foto dos Noivos com Moldura Orgânica -->
      <div class="my-6 flex justify-center">
        <div class="relative w-40 h-40 sm:w-48 sm:h-48">
          <!-- Folhagens decorativas ao redor da moldura -->
          <div class="absolute -inset-5 pointer-events-none z-10 opacity-70 select-none">
            <img src="/assets/svgs/hero-frame-leaves.svg" alt="Folhagens decorativas" class="w-full h-full object-contain" />
          </div>

          <div class="organic-frame w-full h-full overflow-hidden border-2 border-white bg-linen-light relative z-0">
            <img 
              src={weddingData.couple.heroPhoto} 
              alt={coupleNames} 
              class="w-full h-full object-cover select-none"
            />
          </div>
        </div>
      </div>

      <!-- Data e Horário em Destaque -->
      <div class="my-6 py-3 border-t border-b border-olive-200/80 max-w-md mx-auto">
        <p class="font-sans text-xs tracking-widest uppercase text-olive-700 font-semibold mb-1">
          Sábado
        </p>
        <p class="font-serif text-2xl sm:text-3xl text-gray-800 tracking-wide font-medium">
          19 | DEZEMBRO | 2026
        </p>
        <p class="font-sans text-xs tracking-widest text-gray-600 mt-1 uppercase">
          ÀS {time}
        </p>
      </div>

      <!-- Local da Cerimônia e Recepção -->
      <div class="mb-7">
        <p class="font-serif text-lg sm:text-xl text-gray-800 font-medium mb-1">
          Beira Rio
        </p>
        <p class="font-sans text-xs text-olive-700 italic mb-1.5">
          (No antigo Empresa Bar)
        </p>
        <p class="font-sans text-xs text-gray-500 max-w-xs mx-auto leading-relaxed">
          {address}
        </p>
      </div>

      <!-- Divisor Sutil -->
      <div class="w-16 h-px bg-gold-accent/40 mx-auto mb-6"></div>

      <!-- Seção do QR Code & Site -->
      <div class="bg-white/80 backdrop-blur-sm p-4 sm:p-5 rounded-2xl border border-olive-100 max-w-sm mx-auto shadow-sm">
        <p class="font-sans text-[11px] uppercase tracking-wider text-gray-600 font-medium mb-3">
          Aponte a câmera para o QR Code:
        </p>

        <!-- Container do QR Code Dinâmico -->
        <div id="convite-qrcode" class="flex justify-center items-center my-2 p-1.5 bg-white rounded-xl inline-block shadow-sm border border-gray-100" data-site-url={siteUrl}>
          <!-- Gerado dinamicamente -->
        </div>

        <p class="font-sans text-xs font-semibold text-olive-700 mt-2">
          {siteUrl.replace(/^https?:\/\//, '')}
        </p>
        <p class="font-sans text-[10px] text-gray-400 mt-0.5">
          Confirmação de presença e lista de presentes
        </p>
      </div>

      <!-- Botões de Ação Digital -->
      <div class="no-print mt-8 space-y-3 max-w-sm mx-auto">
        <!-- Botão Acessar Site -->
        <a 
          href="/" 
          class="w-full py-3 px-6 rounded-full bg-olive-600 hover:bg-olive-700 active:scale-95 text-white font-sans text-xs sm:text-sm font-medium tracking-wider uppercase transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Acessar Site & Presentes
        </a>

        <div class="grid grid-cols-2 gap-2.5">
          <!-- Botão Confirmar Presença -->
          <a 
            href="/#rsvp" 
            class="py-2.5 px-3 rounded-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-sans text-xs font-medium tracking-wide transition-all shadow-sm flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-olive-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Confirmar RSVP
          </a>

          <!-- Botão Como Chegar (Maps) -->
          <a 
            href={mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="py-2.5 px-3 rounded-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-sans text-xs font-medium tracking-wide transition-all shadow-sm flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Como Chegar
          </a>
        </div>

        <!-- Botão Adicionar à Agenda -->
        <a 
          id="btn-add-calendar"
          href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Casamento+de+Tales+%26+Camila&dates=20261219T190000Z/20261220T020000Z&details=Casamento+de+Tales+%26+Camila.+Mais+informa%C3%A7%C3%B5es:+https://talesecamila2026.netlify.app&location=Beira+Rio,+no+antigo+Empresa+Bar+-+Av.+Lauro+Sodr%C3%A9,+146+-+S%C3%A3o+Miguel+do+Guam%C3%A1,+PA" 
          target="_blank" 
          rel="noopener noreferrer"
          class="w-full py-2.5 px-4 rounded-full bg-linen hover:bg-linen-dark text-gray-600 font-sans text-xs font-medium tracking-wide transition-colors flex items-center justify-center gap-1.5 border border-gray-200/80"
        >
          <svg class="w-3.5 h-3.5 text-olive-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Adicionar ao Calendário Google
        </a>

        <!-- Botão Compartilhar via WhatsApp -->
        <button 
          id="btn-share-whatsapp" 
          type="button"
          class="w-full py-2.5 px-4 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-sans text-xs font-medium tracking-wide transition-colors flex items-center justify-center gap-1.5 shadow-sm cursor-pointer"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
          </svg>
          Compartilhar Convite no WhatsApp
        </button>
      </div>

    </div>
  </main>

  <!-- Rodapé do Convite -->
  <footer class="no-print mt-6 text-center text-xs text-gray-400">
    <p>Com carinho, {coupleNames} ❤️</p>
  </footer>
</InvitationLayout>

<script>
  import QRCode from 'qrcode';

  const qrContainer = document.getElementById('convite-qrcode');
  const targetUrl = qrContainer?.dataset.siteUrl || 'https://talesecamila2026.netlify.app';

  if (qrContainer) {
    QRCode.toDataURL(targetUrl, {
      width: 130,
      margin: 1,
      color: {
        dark: '#2D3748',
        light: '#FFFFFF'
      }
    }).then(url => {
      qrContainer.innerHTML = `<img src="${url}" alt="QR Code do site" class="w-[130px] h-[130px] rounded-lg" />`;
    }).catch(() => {
      qrContainer.innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&margin=2&data=${encodeURIComponent(targetUrl)}" alt="QR Code do site" class="w-[130px] h-[130px] rounded-lg" />`;
    });
  }

  // Compartilhar WhatsApp
  const shareBtn = document.getElementById('btn-share-whatsapp');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const text = encodeURIComponent(
        "💍 *Você está convidado para o Casamento de Tales & Camila!*\n\n" +
        "📅 *Data:* 19 de Dezembro de 2026, às 16h00\n" +
        "📍 *Local:* Beira Rio (no antigo Empresa Bar) - São Miguel do Guamá, PA\n\n" +
        "Acesse o nosso site oficial para ver a lista de presentes e confirmar sua presença:\n" +
        targetUrl
      );
      window.open(`https://wa.me/?text=${text}`, '_blank');
    });
  }
</script>
