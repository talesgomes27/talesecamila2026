---
import InvitationLayout from '../../layouts/InvitationLayout.astro';
import LeafIcon from '../../components/common/LeafIcon.astro';
import { weddingData } from '../../data/weddingData';
import QRCode from 'qrcode';

const siteUrl = weddingData.meta.siteUrl;
const coupleNames = weddingData.couple.names;
const address = weddingData.ceremony.address;
const time = weddingData.ceremony.time;
const mapsUrl = weddingData.ceremony.mapsUrl;

// Geração estática em tempo de build (Zero JavaScript enviado ao cliente)
const qrCodeDataUrl = await QRCode.toDataURL(siteUrl, {
  width: 260,
  margin: 1,
  color: {
    dark: '#2D3748',
    light: '#FFFFFF'
  }
});

// Arquivo iCal / ICS data URI para Apple Calendar / Outlook
const icsContent = [
  'BEGIN:VCALENDAR',
  'VERSION:2.0',
  'PRODID:-//Tales & Camila//Casamento 2026//PT',
  'BEGIN:VEVENT',
  'UID:casamento-tales-camila-20261219@talesecamila2026.netlify.app',
  'DTSTAMP:20261008T120000Z',
  'DTSTART:20261219T193000Z',
  'DTEND:20261220T020000Z',
  'SUMMARY:Casamento de Tales & Camila',
  'DESCRIPTION:Casamento de Tales & Camila. Site: https://talesecamila2026.netlify.app',
  'LOCATION:Beira Rio, no antigo Empresa Bar - Av. Lauro Sodré, 146 - São Miguel do Guamá, PA',
  'END:VEVENT',
  'END:VCALENDAR'
].join('\r\n');
const icsDataUri = `data:text/calendar;charset=utf8,${encodeURIComponent(icsContent)}`;
---

<InvitationLayout>
  <!-- Barra de Ações Superior (Mobile / Web) -->
  <div class="no-print w-full max-w-xl mb-4 flex items-center justify-start text-xs text-gray-600 px-2">
    <a href="/" class="inline-flex items-center gap-1.5 font-medium hover:text-olive-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Ir para o site do casamento
    </a>
  </div>

  <!-- Cartão do Convite -->
  <main class="invitation-card relative w-full max-w-xl bg-[#FAF8F5] rounded-3xl shadow-2xl p-6 sm:p-10 card-border overflow-hidden">
    
    <!-- Ilustrações Botânicas nos Cantos -->
    <div class="absolute -top-6 -left-6 w-28 sm:w-36 pointer-events-none opacity-40 select-none">
      <img src="/assets/svgs/botanical-branch.svg" alt="Ramo floral" class="w-full h-auto" />
    </div>

    <div class="absolute -bottom-8 -right-8 w-28 sm:w-36 pointer-events-none opacity-40 select-none rotate-180">
      <img src="/assets/svgs/botanical-branch.svg" alt="Ramo floral" class="w-full h-auto" />
    </div>

    <div class="relative z-10 text-center">
      
      <!-- Monograma / Iniciais -->
      <div class="inline-flex items-center justify-center mb-3">
        <span class="font-serif text-2xl text-olive-800 font-bold tracking-wider">{weddingData.couple.groom.charAt(0)}</span>
        <span class="font-serif italic text-xl text-gold-accent font-semibold mx-2">&</span>
        <span class="font-serif text-2xl text-olive-800 font-bold tracking-wider">{weddingData.couple.bride.charAt(0)}</span>
      </div>

      <!-- Versículo / Mensagem de Abertura -->
      <p class="font-serif italic text-base sm:text-lg text-gray-900 font-normal max-w-md mx-auto mb-4 leading-relaxed px-2">
        “E quem um dia irá dizer que existe razão nas coisas feitas pelo coração? E quem irá dizer que não existe razão…”
      </p>

      <!-- Texto Institucional do Convite -->
      <p class="font-sans text-xs sm:text-sm text-gray-800 font-medium max-w-md mx-auto mb-5 leading-relaxed tracking-wide px-2">
        Convidamos você para compartilhar esse momento tão nosso, repleto de amor, simplicidade e carinho:
      </p>

      <!-- Nomes dos Noivos -->
      <h1 class="font-serif text-4xl sm:text-5xl text-gray-900 font-semibold tracking-tight leading-none mb-1">
        {weddingData.couple.groom}
        <span class="block font-serif italic text-2xl sm:text-3xl text-gold-accent font-normal my-1">&</span>
        {weddingData.couple.bride}
      </h1>

      <!-- Ícone Folha Minimalista -->
      <div class="w-8 h-4 mx-auto my-3 opacity-90">
        <LeafIcon />
      </div>

      <!-- Foto dos Noivos com Moldura Orgânica -->
      <div class="my-6 flex justify-center">
        <div class="relative w-40 h-40 sm:w-48 sm:h-48">
          <!-- Folhagens decorativas ao redor da moldura -->
          <div class="absolute -inset-5 pointer-events-none z-10 opacity-75 select-none">
            <img src="/assets/svgs/hero-frame-leaves.svg" alt="Folhagens decorativas" class="w-full h-full object-contain" />
          </div>

          <div class="organic-frame w-full h-full overflow-hidden border-2 border-white bg-linen-light relative z-0 shadow-sm">
            <img 
              src={weddingData.couple.heroPhoto} 
              alt={coupleNames} 
              width="192"
              height="192"
              class="w-full h-full object-cover select-none"
            />
          </div>
        </div>
      </div>

      <!-- Data e Horário em Destaque -->
      <div class="my-6 py-3.5 border-y-2 border-olive-300/80 max-w-md mx-auto">
        <p class="font-sans text-xs sm:text-sm tracking-[0.2em] uppercase text-olive-800 font-bold mb-1">
          Sábado
        </p>
        <p class="font-serif text-2xl sm:text-3xl md:text-4xl text-gray-900 tracking-wider font-semibold">
          19 | DEZEMBRO | 2026
        </p>
        <p class="font-sans text-xs sm:text-sm tracking-[0.2em] text-gray-800 font-bold mt-1 uppercase">
          ÀS {time}
        </p>
      </div>

      <!-- Local da Cerimônia e Recepção -->
      <div class="mb-6">
        <p class="font-serif text-2xl sm:text-3xl text-gray-900 font-bold mb-1">
          Beira Rio
        </p>
        <p class="font-sans text-sm text-olive-800 font-semibold italic mb-1.5">
          (No antigo Empresa Bar)
        </p>
        <p class="font-sans text-xs sm:text-sm text-gray-700 font-medium max-w-xs mx-auto leading-relaxed">
          {address}
        </p>
      </div>

      <!-- Às margens do Rio Guamá -->
      <div class="my-6 max-w-md mx-auto px-4">
        <p class="font-serif italic text-base sm:text-lg text-gray-900 font-medium leading-relaxed">
          “Às margens do rio Guamá, onde o tempo desacelera e a vida encontra seu melhor curso, escolhemos celebrar o amor.”
        </p>
      </div>

      <!-- Informações Úteis / Traje & Dica da Noiva -->
      <div class="my-6 p-5 sm:p-6 rounded-2xl bg-white border border-olive-200 shadow-sm text-center max-w-sm mx-auto space-y-4">
        <div>
          <span class="inline-block font-sans text-xs sm:text-sm font-bold uppercase tracking-wider text-olive-900 mb-1">
            Traje: Casual Chique
          </span>
          <p class="font-sans text-xs sm:text-sm text-gray-700 font-medium">
            (Pedimos apenas a gentileza de não usar trajes em tons de verde)
          </p>
        </div>

        <div class="w-16 h-px bg-olive-200 mx-auto"></div>

        <div>
          <p class="font-serif text-sm font-bold text-olive-800 tracking-wide mb-1.5 flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4 text-gold-accent" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
            <span>Dica da Noiva</span>
          </p>
          <p class="font-sans text-xs sm:text-sm text-gray-800 font-medium leading-relaxed">
            Meninas, o terreno é arenoso: evitem vestidos longos e salto fino; apostem no comprimento mídi e salto bloco!
          </p>
        </div>
      </div>

      <!-- Divisor Sutil -->
      <div class="w-16 h-px bg-gold-accent/40 mx-auto mb-6"></div>

      <!-- Seção do QR Code & Site -->
      <div class="bg-white p-5 rounded-2xl border border-olive-200 max-w-sm mx-auto shadow-sm">
        <p class="font-sans text-xs uppercase tracking-wider text-gray-800 font-bold mb-3">
          Aponte a câmera para o QR Code:
        </p>

        <!-- Container do QR Code (Gerado no Build Time pelo SSG) -->
        <div class="flex justify-center items-center my-2 p-1.5 bg-white rounded-xl inline-block shadow-sm border border-gray-100">
          <img 
            src={qrCodeDataUrl} 
            alt="QR Code para o site do casamento" 
            width="130" 
            height="130" 
            loading="eager"
            class="w-[130px] h-[130px] rounded-lg"
          />
        </div>

        <p class="font-sans text-sm font-bold text-olive-800 mt-2.5">
          {siteUrl.replace(/^https?:\/\//, '')}
        </p>
        <p class="font-sans text-xs text-gray-600 mt-1 font-medium">
          Confirmação de presença e lista de presentes
        </p>
      </div>

      <!-- Botões de Ação Digital -->
      <div class="no-print mt-8 space-y-3 max-w-sm mx-auto">
        <!-- Botão Acessar Site -->
        <a 
          href="/" 
          class="w-full py-3 px-6 rounded-full bg-olive-600 hover:bg-olive-700 active:scale-95 text-white font-sans text-xs sm:text-sm font-medium tracking-wider uppercase transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          Acessar Site & Presentes
        </a>

        <div class="grid grid-cols-2 gap-2.5">
          <!-- Botão Confirmar Presença -->
          <a 
            href="/#rsvp" 
            class="py-2.5 px-3 rounded-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-sans text-xs font-medium tracking-wide transition-all shadow-sm flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-olive-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Confirmar RSVP
          </a>

          <!-- Botão Como Chegar (Maps) -->
          <a 
            href={mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="py-2.5 px-3 rounded-full bg-white hover:bg-gray-50 border border-gray-200 text-gray-700 font-sans text-xs font-medium tracking-wide transition-all shadow-sm flex items-center justify-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-blue-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            Como Chegar
          </a>
        </div>

        <!-- Botões de Calendário (Google e Apple/iCal) -->
        <div class="grid grid-cols-2 gap-2">
          <a 
            id="btn-add-calendar"
            href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Casamento+de+Tales+%26+Camila&dates=20261219T193000Z/20261220T020000Z&details=Casamento+de+Tales+%26+Camila.+Mais+informa%C3%A7%C3%B5es:+https://talesecamila2026.netlify.app&location=Beira+Rio,+no+antigo+Empresa+Bar+-+Av.+Lauro+Sodr%C3%A9,+146+-+S%C3%A3o+Miguel+do+Guam%C3%A1,+PA" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 px-3 rounded-full bg-linen hover:bg-linen-dark text-gray-600 font-sans text-xs font-medium tracking-wide transition-colors flex items-center justify-center gap-1.5 border border-gray-200/80"
          >
            <svg class="w-3.5 h-3.5 text-olive-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Google Agenda
          </a>

          <a 
            id="btn-add-ical"
            href={icsDataUri} 
            download="casamento-tales-e-camila.ics"
            class="w-full py-2.5 px-3 rounded-full bg-linen hover:bg-linen-dark text-gray-600 font-sans text-xs font-medium tracking-wide transition-colors flex items-center justify-center gap-1.5 border border-gray-200/80"
          >
            <svg class="w-3.5 h-3.5 text-gray-700" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-1.99.6-2.63 1.35-.57.66-.97 1.73-.84 2.76 1 .08 2.03-.51 2.55-1.26z"/>
            </svg>
            Apple / iCal
          </a>
        </div>
      </div>

    </div>
  </main>

  <!-- Rodapé do Convite -->
  <footer class="no-print mt-6 text-center text-xs text-gray-400">
    <p>Com carinho, {coupleNames} ❤️</p>
  </footer>
</InvitationLayout>
