---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import Toast from '../components/common/Toast.astro';
import { weddingData } from '../data/weddingData';
import { buildSocialMetadata } from '../utils/socialMetadata';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title = `${weddingData.couple.names} | Nosso Casamento (19.12.2026)`, 
  description = weddingData.meta.description,
  ogImage = weddingData.meta.ogImage
} = Astro.props;

const social = buildSocialMetadata({
  title,
  ogTitle: `Casamento de ${weddingData.couple.names} | 19.12.2026 às ${weddingData.ceremony.time}`,
  description,
  ogDescription: 'Com muita alegria convidamos você para celebrar o nosso grande dia! Acesse para confirmar sua presença e ver a lista de presentes.',
  path: Astro.url.pathname,
  siteOrigin: Astro.site || weddingData.meta.siteUrl,
  image: ogImage,
});
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#FAF8F5" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content={weddingData.couple.names} />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{social.title}</title>
  <meta name="description" content={social.description} />
  <link rel="canonical" href={social.canonicalUrl} />

  <!-- Metatags Open Graph / WhatsApp Preview (Gold Standard) -->
  <meta property="og:type" content={social.openGraph.type} />
  <meta property="og:locale" content={social.openGraph.locale} />
  <meta property="og:url" content={social.openGraph.url} />
  <meta property="og:title" content={social.openGraph.title} />
  <meta property="og:description" content={social.openGraph.description} />
  <meta property="og:image" content={social.openGraph.image.url} />
  <meta property="og:image:secure_url" content={social.openGraph.image.secureUrl} />
  <meta property="og:image:type" content={social.openGraph.image.type} />
  <meta property="og:image:width" content={String(social.openGraph.image.width)} />
  <meta property="og:image:height" content={String(social.openGraph.image.height)} />
  <meta property="og:image:alt" content={social.openGraph.image.alt} />
  <meta property="og:site_name" content={social.openGraph.siteName} />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content={social.twitter.card} />
  <meta name="twitter:title" content={social.twitter.title} />
  <meta name="twitter:description" content={social.twitter.description} />
  <meta name="twitter:image" content={social.twitter.image} />
  <meta name="twitter:image:alt" content={social.twitter.imageAlt} />

  <!-- Dados Estruturados do Evento (Schema.org/SocialEvent) -->
  <script type="application/ld+json" set:html={social.jsonLd} />

  <!-- Otimização de Fontes (Carregamento Não-Bloqueante + Pesos Enxutos) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    />
  </noscript>
</head>
<body class="bg-linen-texture text-ink antialiased selection:bg-olive-100 selection:text-olive-900 min-h-screen flex flex-col">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-2.5 focus:rounded-full focus:bg-olive-900 focus:text-linen focus:font-sans focus:text-xs focus:uppercase focus:tracking-[0.18em] focus:shadow-lg"
  >
    Pular para o conteúdo principal
  </a>
  <div class="editorial-grain" aria-hidden="true"></div>
  <Navbar />
  
  <main id="main-content" class="flex-grow">
    <slot />
  </main>

  <Footer coupleNames={weddingData.couple.names} weddingDateFormatted={weddingData.ceremony.dateFormatted} />
  <Toast />

  <script>
    const revealEls = document.querySelectorAll<HTMLElement>('.reveal-on-scroll');
    if (revealEls.length && 'IntersectionObserver' in window) {
      const revealObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            }
          });
        },
        { threshold: 0, rootMargin: '0px 0px -24px 0px' }
      );
      revealEls.forEach((el) => revealObserver.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</body>
</html>
