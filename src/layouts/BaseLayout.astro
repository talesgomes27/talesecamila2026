---
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import Toast from '../components/common/Toast.astro';
import { weddingData } from '../data/weddingData';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { 
  title = `${weddingData.couple.names} | Nosso Casamento`, 
  description = weddingData.meta.description,
  ogImage = weddingData.meta.ogImage
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://talesecamila2026.netlify.app');
const fullOgImageUrl = new URL(ogImage, Astro.site || 'https://talesecamila2026.netlify.app').href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>

  <!-- Metatags Open Graph / WhatsApp Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`Casamento de ${weddingData.couple.names} | 19.12.2026`} />
  <meta property="og:description" content="Com muita alegria convidamos você para celebrar o nosso grande dia! Acesse para confirmar sua presença e ver a lista de presentes." />
  <meta property="og:image" content={fullOgImageUrl} />
  <meta property="og:image:secure_url" content={fullOgImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Convite de Casamento de ${weddingData.couple.names}`} />
  <meta property="og:site_name" content={`Casamento ${weddingData.couple.names}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`Casamento de ${weddingData.couple.names} | 19.12.2026`} />
  <meta name="twitter:description" content="Com muita alegria convidamos você para celebrar o nosso grande dia! Acesse para confirmar sua presença e ver a lista de presentes." />
  <meta name="twitter:image" content={fullOgImageUrl} />

  <!-- Google Fonts Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body class="bg-linen-texture text-gray-800 antialiased selection:bg-olive-100 selection:text-olive-800 min-h-screen flex flex-col">
  <Navbar />
  
  <main class="flex-grow">
    <slot />
  </main>

  <Footer coupleNames={weddingData.couple.names} weddingDateFormatted={weddingData.ceremony.dateFormatted} />
  <Toast />
</body>
</html>
