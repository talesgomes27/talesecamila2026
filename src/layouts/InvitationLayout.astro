---
import { weddingData } from '../data/weddingData';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `Convite de Casamento | ${weddingData.couple.names}`,
  description = `Você está convidado para celebrar o casamento de ${weddingData.couple.names} no dia ${weddingData.ceremony.dateFormatted}, às ${weddingData.ceremony.time} em São Miguel do Guamá - PA. Clique para abrir seu convite!`,
  ogImage = weddingData.meta.ogImage
} = Astro.props;

const canonicalURL = new URL('/convite/', Astro.site || 'https://talesecamila2026.netlify.app');
const fullOgImageUrl = new URL(ogImage, Astro.site || 'https://talesecamila2026.netlify.app').href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#F3EFEA" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/assets/svgs/leaf-icon.svg" />
  <title>{title}</title>

  <!-- Metatags Open Graph / WhatsApp Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`💍 Convite de Casamento | ${weddingData.couple.names}`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImageUrl} />
  <meta property="og:image:secure_url" content={fullOgImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Convite de Casamento de ${weddingData.couple.names}`} />
  <meta property="og:site_name" content={`Convite ${weddingData.couple.names}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`💍 Convite de Casamento | ${weddingData.couple.names}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImageUrl} />

  <!-- Otimização de Fontes (Carregamento Não-Bloqueante + Pesos Enxutos) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    />
  </noscript>

  <style is:global>
    body.convite-body {
      font-family: 'Montserrat', system-ui, sans-serif;
      background-color: #F3EFEA;
      background-image:
        radial-gradient(at 20% 15%, rgba(158, 147, 104, 0.08) 0px, transparent 50%),
        radial-gradient(#E5DFD5 0.65px, transparent 0.65px);
      background-size: 100% 100%, 24px 24px;
      color: #1E241F;
    }

    .card-border {
      border: 1px solid rgba(158, 147, 104, 0.35);
      box-shadow: 0 32px 64px -20px rgba(29, 44, 30, 0.14), 0 8px 24px -8px rgba(29, 44, 30, 0.05);
      position: relative;
    }

    .card-border::before {
      content: "";
      position: absolute;
      inset: 8px;
      border: 1px solid rgba(158, 147, 104, 0.35);
      border-radius: calc(2rem - 8px);
      pointer-events: none;
    }

    @media print {
      body.convite-body {
        background: none !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .invitation-card {
        box-shadow: none !important;
        border: 1px solid #B0A795 !important;
        max-width: 100% !important;
        margin: 0 auto !important;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body class="convite-body min-h-[100dvh] py-10 px-4 sm:px-6 flex flex-col items-center justify-center selection:bg-olive-100 selection:text-olive-900">
  <div class="editorial-grain no-print" aria-hidden="true"></div>
  <slot />
</body>
</html>
