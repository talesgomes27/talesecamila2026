---
import { ViewTransitions } from 'astro:transitions';
import { weddingData } from '../data/weddingData';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `Convite de Casamento | ${weddingData.couple.names}`,
  description = `Você está convidado para celebrar o casamento de ${weddingData.couple.names} no dia ${weddingData.ceremony.dateFormatted}, às ${weddingData.ceremony.time} em São Miguel do Guamá - PA. Clique para abrir seu convite!`,
  ogImage = weddingData.meta.ogImage
} = Astro.props;

const canonicalURL = new URL('/convite/', Astro.site || 'https://talesecamila2026.netlify.app');
const fullOgImageUrl = new URL(ogImage, Astro.site || 'https://talesecamila2026.netlify.app').href;
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/assets/svgs/leaf-icon.svg" />
  <title>{title}</title>

  <!-- View Transitions para transição suave de página -->
  <ViewTransitions />

  <!-- Metatags Open Graph / WhatsApp Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={`💍 Convite de Casamento | ${weddingData.couple.names}`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImageUrl} />
  <meta property="og:image:secure_url" content={fullOgImageUrl} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`Convite de Casamento de ${weddingData.couple.names}`} />
  <meta property="og:site_name" content={`Convite ${weddingData.couple.names}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`💍 Convite de Casamento | ${weddingData.couple.names}`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImageUrl} />

  <!-- Otimização de Fontes (DNS Prefetch & Preconnect) -->
  <link rel="dns-prefetch" href="https://fonts.googleapis.com">
  <link rel="dns-prefetch" href="https://fonts.gstatic.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

  <style is:global>
    body.convite-body {
      font-family: 'Montserrat', system-ui, sans-serif;
      background-color: #F3EFEA;
      background-image: radial-gradient(#E5DFD5 0.75px, transparent 0.75px);
      background-size: 24px 24px;
      color: #2D3748;
    }

    .organic-frame {
      border-radius: 54% 46% 62% 38% / 48% 58% 42% 52%;
      box-shadow: 0 16px 36px -12px rgba(80, 117, 82, 0.25);
    }

    .organic-frame img {
      object-fit: cover;
      object-position: center 38%;
    }

    .card-border {
      border: 1px solid #D6CEBE;
      position: relative;
    }

    .card-border::before {
      content: "";
      position: absolute;
      inset: 6px;
      border: 1px solid rgba(163, 155, 117, 0.45);
      border-radius: inherit;
      pointer-events: none;
    }

    @media print {
      body.convite-body {
        background: none !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .invitation-card {
        box-shadow: none !important;
        border: 1px solid #B0A795 !important;
        max-width: 100% !important;
        margin: 0 auto !important;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body class="convite-body min-h-screen py-8 px-4 sm:px-6 flex flex-col items-center justify-center selection:bg-olive-100 selection:text-olive-800">
  <slot />
</body>
</html>
