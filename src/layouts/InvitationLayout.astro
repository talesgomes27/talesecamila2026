---
import { weddingData } from '../data/weddingData';
import { buildSocialMetadata } from '../utils/socialMetadata';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `Convite de Casamento | ${weddingData.couple.names}`,
  description = `Você está convidado para celebrar o casamento de ${weddingData.couple.names} no dia ${weddingData.ceremony.dateFormatted}, às ${weddingData.ceremony.time}, em São Miguel do Guamá - PA. Toque para abrir seu convite!`,
  ogImage = weddingData.meta.ogImage
} = Astro.props;

const social = buildSocialMetadata({
  title,
  ogTitle: `💍 Convite de Casamento | ${weddingData.couple.names} (19.12.2026 às ${weddingData.ceremony.time})`,
  description,
  path: Astro.url.pathname || '/convite/',
  siteOrigin: Astro.site || weddingData.meta.siteUrl,
  image: ogImage,
  siteName: `Convite ${weddingData.couple.names}`,
});
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#F3EFEA" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content={weddingData.couple.names} />
  <link rel="manifest" href="/site.webmanifest" />

  <title>{social.title}</title>
  <meta name="description" content={social.description} />
  <link rel="canonical" href={social.canonicalUrl} />

  <!-- Metatags Open Graph / WhatsApp Preview (Gold Standard) -->
  <meta property="og:type" content={social.openGraph.type} />
  <meta property="og:locale" content={social.openGraph.locale} />
  <meta property="og:url" content={social.openGraph.url} />
  <meta property="og:title" content={social.openGraph.title} />
  <meta property="og:description" content={social.openGraph.description} />
  <meta property="og:image" content={social.openGraph.image.url} />
  <meta property="og:image:secure_url" content={social.openGraph.image.secureUrl} />
  <meta property="og:image:type" content={social.openGraph.image.type} />
  <meta property="og:image:width" content={String(social.openGraph.image.width)} />
  <meta property="og:image:height" content={String(social.openGraph.image.height)} />
  <meta property="og:image:alt" content={social.openGraph.image.alt} />
  <meta property="og:site_name" content={social.openGraph.siteName} />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content={social.twitter.card} />
  <meta name="twitter:title" content={social.twitter.title} />
  <meta name="twitter:description" content={social.twitter.description} />
  <meta name="twitter:image" content={social.twitter.image} />
  <meta name="twitter:image:alt" content={social.twitter.imageAlt} />

  <!-- Dados Estruturados do Evento (Schema.org/SocialEvent) -->
  <script type="application/ld+json" set:html={social.jsonLd} />

  <!-- Otimização de Fontes (Carregamento Não-Bloqueante + Pesos Enxutos) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
  />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap"
    />
  </noscript>

  <style is:global>
    body.convite-body {
      font-family: 'Montserrat', system-ui, sans-serif;
      background-color: #F3EFEA;
      background-image:
        radial-gradient(at 20% 15%, rgba(158, 147, 104, 0.08) 0px, transparent 50%),
        radial-gradient(#E5DFD5 0.65px, transparent 0.65px);
      background-size: 100% 100%, 24px 24px;
      color: #1E241F;
    }

    .card-border {
      border: 1px solid rgba(158, 147, 104, 0.35);
      box-shadow: 0 32px 64px -20px rgba(29, 44, 30, 0.14), 0 8px 24px -8px rgba(29, 44, 30, 0.05);
      position: relative;
    }

    .card-border::before {
      content: "";
      position: absolute;
      inset: 8px;
      border: 1px solid rgba(158, 147, 104, 0.35);
      border-radius: calc(2rem - 8px);
      pointer-events: none;
    }

    @media print {
      body.convite-body {
        background: none !important;
        padding: 0 !important;
      }
      .no-print {
        display: none !important;
      }
      .invitation-card {
        box-shadow: none !important;
        border: 1px solid #B0A795 !important;
        max-width: 100% !important;
        margin: 0 auto !important;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body class="convite-body min-h-[100dvh] py-10 px-4 sm:px-6 flex flex-col items-center justify-center selection:bg-olive-100 selection:text-olive-900">
  <div class="editorial-grain no-print" aria-hidden="true"></div>
  <slot />
</body>
</html>
